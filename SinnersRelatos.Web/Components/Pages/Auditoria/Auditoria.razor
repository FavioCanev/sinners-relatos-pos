@page "/auditoria"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SinnersRelatos.Web.Models
@using SinnersRelatos.Web.Services.Interfaces
@inject IAuditoriaService AuditoriaService
@inject IUsuarioService UsuarioService
@inject ISesionService SesionService
@inject NavigationManager Navigation

<PageTitle>Auditoría</PageTitle>

<h1>Log de Auditoría</h1>

<div class="row g-2 align-items-end mb-3">
    <div class="col-md-3">
        <label class="form-label">Desde</label>
        <input type="date" class="form-control" @bind="desde" @bind:after="CargarAsync" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Hasta</label>
        <input type="date" class="form-control" @bind="hasta" @bind:after="CargarAsync" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Usuario</label>
        <select class="form-select" @bind="usuarioIdTexto" @bind:after="CargarAsync">
            <option value="">Todos</option>
            @foreach (var u in usuarios)
            {
                <option value="@u.Id">@u.NombreUsuario</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Tipo de acción</label>
        <select class="form-select" @bind="tipoAccion" @bind:after="CargarAsync">
            <option value="">Todos</option>
            @foreach (var tipo in tiposAccion)
            {
                <option value="@tipo">@tipo</option>
            }
        </select>
    </div>
</div>

@if (cargando)
{
    <p><em>Cargando...</em></p>
}
else if (logs.Count == 0)
{
    <p><em>No hay registros para los filtros seleccionados.</em></p>
}
else
{
    <p class="text-muted">@logs.Count registro(s) (máximo 500 más recientes)</p>
    <div class="table-responsive">
        <table class="table table-striped table-sm align-middle">
            <thead>
                <tr>
                    <th>Fecha/Hora</th>
                    <th>Usuario</th>
                    <th>Tipo de acción</th>
                    <th>Detalle</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in logs)
                {
                    <tr>
                        <td class="text-nowrap">@log.FechaHora.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td class="text-nowrap">@(log.Usuario is null ? "—" : log.Usuario.NombreUsuario)</td>
                        <td class="text-nowrap">@log.TipoAccion</td>
                        <td>@log.Detalle</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<LogAuditoria> logs = [];
    private List<Usuario> usuarios = [];
    private List<string> tiposAccion = [];
    private bool cargando = true;

    private DateTime? desde;
    private DateTime? hasta;
    private string usuarioIdTexto = "";
    private string tipoAccion = "";

    protected override async Task OnInitializedAsync()
    {
        var usuarioActor = await SesionService.ObtenerUsuarioActualAsync();
        if (usuarioActor is null)
        {
            Navigation.NavigateTo("/login?returnUrl=/auditoria");
            return;
        }
        if (usuarioActor.Rol != RolUsuario.Administrador)
        {
            Navigation.NavigateTo("/mesas");
            return;
        }

        usuarios = await UsuarioService.ListarAsync(incluirInactivos: true);
        tiposAccion = await AuditoriaService.ListarTiposAccionAsync();
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;

        int? usuarioId = int.TryParse(usuarioIdTexto, out var uid) ? uid : null;
        DateTime? hastaInclusive = hasta?.AddDays(1).AddTicks(-1);

        logs = await AuditoriaService.ListarAsync(desde, hastaInclusive, usuarioId, string.IsNullOrWhiteSpace(tipoAccion) ? null : tipoAccion);
        cargando = false;
    }
}
