@page "/dashboard"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SinnersRelatos.Web.Models
@using SinnersRelatos.Web.Services.Interfaces
@inject IDashboardService DashboardService
@inject ISesionService SesionService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Dashboard</PageTitle>

<div class="dashboard-wide">
    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3">
        <h1 class="mb-0">Dashboard de Ventas</h1>
        <div class="d-flex gap-3 align-items-end flex-wrap">
            <div>
                <label class="form-label mb-0 d-block">Marca</label>
                <div class="filtro-marca">
                    <button class="filtro-marca-btn @(marcaSeleccionada is null ? "activo" : "")" @onclick="() => CambiarMarcaAsync(null)">Todos</button>
                    <button class="filtro-marca-btn @(marcaSeleccionada == Marca.Sinners ? "activo" : "")" @onclick="() => CambiarMarcaAsync(Marca.Sinners)">Sinners</button>
                    <button class="filtro-marca-btn @(marcaSeleccionada == Marca.Relatos ? "activo" : "")" @onclick="() => CambiarMarcaAsync(Marca.Relatos)">Relatos</button>
                </div>
            </div>
            <div>
                <label class="form-label mb-0">Desde</label>
                <input type="date" class="form-control" @bind="desde" @bind:after="CargarAsync" />
            </div>
            <div>
                <label class="form-label mb-0">Hasta</label>
                <input type="date" class="form-control" @bind="hasta" @bind:after="CargarAsync" />
            </div>
        </div>
    </div>

    @if (cargando)
    {
        <p><em>Cargando...</em></p>
    }
    else if (resumen is null)
    {
        <p><em>No se pudo cargar la información.</em></p>
    }
    else
    {
        <div class="row g-3 mb-3">
            <div class="col-6 col-lg-3">
                <div class="stat-card">
                    <span class="stat-label">Total Ventas</span>
                    <span class="stat-value">S/ @resumen.TotalVentas.ToString("N2")</span>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="stat-card">
                    <span class="stat-label">Pedidos</span>
                    <span class="stat-value">@resumen.CantidadPedidos</span>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="stat-card">
                    <span class="stat-label">Ticket Promedio</span>
                    <span class="stat-value">S/ @resumen.TicketPromedio.ToString("N2")</span>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="stat-card @(resumen.IngredientesBajoStock > 0 ? "stat-card-alerta" : "")">
                    <span class="stat-label">Ingredientes Bajo Stock</span>
                    <span class="stat-value">@resumen.IngredientesBajoStock</span>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-lg-@(marcaSeleccionada is null ? "8" : "12")">
                <div class="chart-card">
                    <h5>Ventas por día@(marcaSeleccionada is null ? "" : $" · {marcaSeleccionada}")</h5>
                    <div class="chart-wrap">
                        <canvas id="chartVentasPorDia"></canvas>
                    </div>
                </div>
            </div>
            @if (marcaSeleccionada is null)
            {
                <div class="col-lg-4">
                    <div class="chart-card h-100">
                        <h5>Ventas por marca</h5>
                        @foreach (var v in resumen.VentasPorMarca)
                        {
                            <div class="marca-row">
                                <span>@v.Marca</span>
                                <strong>S/ @v.Total.ToString("N2")</strong>
                            </div>
                        }
                        @if (resumen.VentasPorMarca.Count == 0)
                        {
                            <p class="text-muted"><em>Sin datos en el rango seleccionado.</em></p>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="row g-3 mb-3">
            <div class="col-lg-12">
                <div class="chart-card">
                    <h5>Productos más pedidos@(marcaSeleccionada is null ? "" : $" · {marcaSeleccionada}")</h5>
                    <div class="chart-wrap chart-wrap-barras">
                        <canvas id="chartTopProductos"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <h5 class="mb-2">Stock disponible para preparar@(marcaSeleccionada is null ? "" : $" · {marcaSeleccionada}")</h5>
        @if (stockPorCategoria.Count == 0)
        {
            <p class="text-muted">
                <em>Ningún producto tiene una receta de ingredientes configurada todavía. Este gráfico se completa a medida que se asignen recetas en Ingredientes/Productos.</em>
            </p>
        }
        else
        {
            <div class="row g-3">
                @for (var i = 0; i < stockPorCategoria.Count; i++)
                {
                    var categoria = stockPorCategoria[i];
                    <div class="col-lg-4 col-md-6">
                        <div class="chart-card">
                            <h6>@categoria.CategoriaNombre@(marcaSeleccionada is null ? $" · {categoria.Marca}" : "")</h6>
                            <div class="chart-wrap">
                                <canvas id="chartStock_@i"></canvas>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

<style>
    .dashboard-wide {
        max-width: 1400px;
    }

    .stat-card {
        background: var(--brand-bg-alt, #f7f2ea);
        border-radius: 0.5rem;
        padding: 1rem 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        border-left: 4px solid var(--brand-primary, #650610);
    }

    .stat-card-alerta {
        border-left-color: #b8863b;
    }

    .stat-label {
        font-size: 0.85rem;
        color: #6c757d;
    }

    .stat-value {
        font-size: 1.6rem;
        font-weight: 700;
    }

    .chart-card {
        background: #fff;
        border: 1px solid #e5e0d8;
        border-radius: 0.5rem;
        padding: 1rem;
    }

    .chart-wrap {
        position: relative;
        height: 280px;
    }

    .chart-wrap-barras {
        height: 320px;
    }

    .filtro-marca {
        display: flex;
        border: 1px solid var(--brand-secondary, #b8863b);
        border-radius: 0.5rem;
        overflow: hidden;
    }

    .filtro-marca-btn {
        border: none;
        background: #fff;
        color: var(--brand-secondary-dark, #96692a);
        padding: 0.375rem 0.9rem;
        font-size: 0.9rem;
        font-weight: 600;
        line-height: 1.5;
    }

    .filtro-marca-btn:not(:last-child) {
        border-right: 1px solid var(--brand-secondary, #b8863b);
    }

    .filtro-marca-btn.activo {
        background: var(--brand-secondary, #b8863b);
        color: #fff;
    }

    .marca-row {
        display: flex;
        justify-content: space-between;
        padding: 0.5rem 0;
        border-bottom: 1px solid #eee;
    }
</style>

@code {
    private ResumenVentas? resumen;
    private List<CategoriaStock> stockPorCategoria = [];
    private bool cargando = true;
    private DateTime desde = DateTime.Today.AddDays(-6);
    private DateTime hasta = DateTime.Today;
    private Marca? marcaSeleccionada;
    private bool datosListosParaRenderizar;
    private bool stockListoParaRenderizar;

    protected override async Task OnInitializedAsync()
    {
        var usuarioActor = await SesionService.ObtenerUsuarioActualAsync();
        if (usuarioActor is null)
        {
            Navigation.NavigateTo("/login?returnUrl=/dashboard");
            return;
        }
        if (usuarioActor.Rol != RolUsuario.Administrador)
        {
            Navigation.NavigateTo("/mesas");
            return;
        }

        await CargarStockAsync();
        await CargarAsync();
    }

    private async Task CambiarMarcaAsync(Marca? marca)
    {
        marcaSeleccionada = marca;
        await CargarStockAsync();
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;
        StateHasChanged();

        var hastaInclusive = hasta.Date.AddDays(1).AddTicks(-1);
        resumen = await DashboardService.ObtenerResumenAsync(desde.Date, hastaInclusive, marcaSeleccionada);
        cargando = false;
        datosListosParaRenderizar = true;
    }

    private async Task CargarStockAsync()
    {
        stockPorCategoria = await DashboardService.ObtenerStockPorCategoriaAsync(marcaSeleccionada);
        stockListoParaRenderizar = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (datosListosParaRenderizar && resumen is not null)
        {
            datosListosParaRenderizar = false;
            await RenderizarGraficosAsync();
        }

        if (stockListoParaRenderizar)
        {
            stockListoParaRenderizar = false;
            await RenderizarStockGraficosAsync();
        }
    }

    private async Task RenderizarStockGraficosAsync()
    {
        for (var i = 0; i < stockPorCategoria.Count; i++)
        {
            var categoria = stockPorCategoria[i];
            var etiquetas = categoria.Productos.Select(p => p.Nombre).ToArray();
            var datos = categoria.Productos.Select(p => p.CantidadDisponible).ToArray();
            await JS.InvokeVoidAsync("dashboardCharts.renderBarrasVerticales", $"chartStock_{i}", etiquetas, datos, "#650610");
        }
    }

    private async Task RenderizarGraficosAsync()
    {
        if (resumen is null) return;

        var etiquetasDias = resumen.VentasPorDia.Select(v => v.Fecha.ToString("dd/MM")).ToArray();
        var totalesDias = resumen.VentasPorDia.Select(v => v.Total).ToArray();
        await JS.InvokeVoidAsync("dashboardCharts.renderLinea", "chartVentasPorDia", etiquetasDias, totalesDias, "#650610");

        var etiquetasProductos = resumen.TopProductos.Select(p => $"{p.Nombre} ({p.Marca})").ToArray();
        var cantidadesProductos = resumen.TopProductos.Select(p => p.CantidadVendida).ToArray();
        await JS.InvokeVoidAsync("dashboardCharts.renderBarras", "chartTopProductos", etiquetasProductos, cantidadesProductos, "#b8863b");
    }
}
