@page "/usuarios"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.ComponentModel.DataAnnotations
@using SinnersRelatos.Web.Models
@using SinnersRelatos.Web.Services.Interfaces
@inject IUsuarioService UsuarioService
@inject IEmpleadoService EmpleadoService
@inject ISesionService SesionService
@inject NavigationManager Navigation

<PageTitle>Usuarios y Empleados</PageTitle>

<h1>Usuarios y Empleados</h1>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="incluirInactivos" @bind="incluirInactivos" @bind:after="CargarUsuariosAsync" />
        <label class="form-check-label" for="incluirInactivos">Mostrar inactivos</label>
    </div>
    <button class="btn btn-primary" @onclick="MostrarFormularioCreacion">+ Nuevo Empleado</button>
</div>

@if (mensajeError is not null)
{
    <div class="alert alert-danger alert-dismissible">
        @mensajeError
        <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
    </div>
}

@if (mostrandoFormulario)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">@(formulario.UsuarioId is null ? "Nuevo Empleado" : "Editar Empleado")</h5>
            <EditForm Model="formulario" OnValidSubmit="GuardarAsync">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nombres</label>
                        <InputText class="form-control" @bind-Value="formulario.Nombres" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Apellidos</label>
                        <InputText class="form-control" @bind-Value="formulario.Apellidos" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Teléfono</label>
                        <InputText class="form-control" @bind-Value="formulario.Telefono" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Rol</label>
                        <InputSelect class="form-select" @bind-Value="formulario.Rol">
                            <option value="@RolUsuario.Mesero">Mesero</option>
                            <option value="@RolUsuario.Administrador">Administrador</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Nombre de usuario</label>
                        <InputText class="form-control" @bind-Value="formulario.NombreUsuario" disabled="@(formulario.UsuarioId is not null)" />
                    </div>
                    @if (formulario.UsuarioId is null)
                    {
                        <div class="col-md-6">
                            <label class="form-label">Contraseña</label>
                            <InputText type="password" class="form-control" @bind-Value="formulario.Password" />
                        </div>
                    }
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">Guardar</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="CerrarFormulario">Cancelar</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (usuarioCambiandoPassword is not null)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Cambiar contraseña — @usuarioCambiandoPassword.Empleado.Nombres @usuarioCambiandoPassword.Empleado.Apellidos</h5>
            <EditForm Model="formularioPassword" OnValidSubmit="GuardarPasswordAsync">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nueva contraseña</label>
                        <InputText type="password" class="form-control" @bind-Value="formularioPassword.Password" />
                    </div>
                </div>
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">Actualizar contraseña</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => usuarioCambiandoPassword = null">Cancelar</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (cargando)
{
    <p><em>Cargando...</em></p>
}
else if (usuarios.Count == 0)
{
    <p><em>No hay empleados registrados.</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Usuario</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in usuarios)
                {
                    <tr>
                        <td>@usuario.Empleado.Nombres @usuario.Empleado.Apellidos</td>
                        <td>@usuario.NombreUsuario</td>
                        <td>@usuario.Rol</td>
                        <td>
                            @if (usuario.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => MostrarFormularioEdicion(usuario)">Editar</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => MostrarCambioPassword(usuario)">Contraseña</button>
                            @if (usuario.Activo)
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => CambiarEstadoAsync(usuario, false)">Desactivar</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-success" @onclick="() => CambiarEstadoAsync(usuario, true)">Activar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Usuario> usuarios = [];
    private bool cargando = true;
    private bool incluirInactivos;
    private bool mostrandoFormulario;
    private string? mensajeError;
    private FormularioUsuario formulario = new();
    private Usuario? usuarioCambiandoPassword;
    private FormularioPassword formularioPassword = new();

    private UsuarioSesion? usuarioActor;

    protected override async Task OnInitializedAsync()
    {
        usuarioActor = await SesionService.ObtenerUsuarioActualAsync();
        if (usuarioActor is null)
        {
            Navigation.NavigateTo("/login?returnUrl=/usuarios");
            return;
        }
        if (usuarioActor.Rol != RolUsuario.Administrador)
        {
            Navigation.NavigateTo("/mesas");
            return;
        }

        await CargarUsuariosAsync();
    }

    private async Task CargarUsuariosAsync()
    {
        cargando = true;
        usuarios = await UsuarioService.ListarAsync(incluirInactivos);
        cargando = false;
    }

    private void MostrarFormularioCreacion()
    {
        formulario = new FormularioUsuario();
        mensajeError = null;
        mostrandoFormulario = true;
    }

    private void MostrarFormularioEdicion(Usuario usuario)
    {
        formulario = new FormularioUsuario
        {
            EmpleadoId = usuario.EmpleadoId,
            UsuarioId = usuario.Id,
            Nombres = usuario.Empleado.Nombres,
            Apellidos = usuario.Empleado.Apellidos,
            Telefono = usuario.Empleado.Telefono,
            NombreUsuario = usuario.NombreUsuario,
            Rol = usuario.Rol
        };
        mensajeError = null;
        mostrandoFormulario = true;
    }

    private void CerrarFormulario()
    {
        mostrandoFormulario = false;
    }

    private void MostrarCambioPassword(Usuario usuario)
    {
        usuarioCambiandoPassword = usuario;
        formularioPassword = new FormularioPassword();
    }

    private async Task GuardarAsync()
    {
        try
        {
            if (formulario.UsuarioId is null)
            {
                if (string.IsNullOrWhiteSpace(formulario.Password) || formulario.Password.Length < 6)
                {
                    mensajeError = "La contraseña debe tener al menos 6 caracteres.";
                    return;
                }

                var empleado = new Empleado
                {
                    Nombres = formulario.Nombres,
                    Apellidos = formulario.Apellidos,
                    Telefono = formulario.Telefono
                };

                await UsuarioService.CrearAsync(empleado, formulario.NombreUsuario, formulario.Password, formulario.Rol, usuarioActor!.Id);
            }
            else
            {
                var empleado = await EmpleadoService.ObtenerPorIdAsync(formulario.EmpleadoId!.Value);
                if (empleado is null)
                {
                    mensajeError = "El empleado ya no existe.";
                    return;
                }

                empleado.Nombres = formulario.Nombres;
                empleado.Apellidos = formulario.Apellidos;
                empleado.Telefono = formulario.Telefono;
                await EmpleadoService.ActualizarAsync(empleado);
                await UsuarioService.ActualizarRolAsync(formulario.UsuarioId.Value, formulario.Rol, usuarioActor!.Id);
            }

            mostrandoFormulario = false;
            mensajeError = null;
            await CargarUsuariosAsync();
        }
        catch (InvalidOperationException ex)
        {
            mensajeError = ex.Message;
        }
    }

    private async Task GuardarPasswordAsync()
    {
        if (usuarioCambiandoPassword is null)
            return;

        await UsuarioService.CambiarPasswordAsync(usuarioCambiandoPassword.Id, formularioPassword.Password, usuarioActor!.Id);
        usuarioCambiandoPassword = null;
    }

    private async Task CambiarEstadoAsync(Usuario usuario, bool activo)
    {
        await UsuarioService.CambiarEstadoAsync(usuario.Id, activo, usuarioActor!.Id);
        await CargarUsuariosAsync();
    }

    private class FormularioUsuario
    {
        public int? EmpleadoId { get; set; }
        public int? UsuarioId { get; set; }

        [Required(ErrorMessage = "El nombre es obligatorio")]
        public string Nombres { get; set; } = "";

        [Required(ErrorMessage = "El apellido es obligatorio")]
        public string Apellidos { get; set; } = "";

        public string? Telefono { get; set; }

        [Required(ErrorMessage = "El nombre de usuario es obligatorio")]
        public string NombreUsuario { get; set; } = "";

        public string? Password { get; set; }

        public RolUsuario Rol { get; set; } = RolUsuario.Mesero;
    }

    private class FormularioPassword
    {
        [Required(ErrorMessage = "La contraseña es obligatoria")]
        [MinLength(6, ErrorMessage = "La contraseña debe tener al menos 6 caracteres")]
        public string Password { get; set; } = "";
    }
}
