@using SinnersRelatos.Web.Components
@using SinnersRelatos.Web.Hubs
@using SinnersRelatos.Web.Models
@using SinnersRelatos.Web.Services.Interfaces
@inject IPedidoService PedidoService
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="kds-panel" style="--kds-color: @Color">
    <div class="kds-header">
        <h1>@Titulo</h1>
        <div class="d-flex align-items-center gap-3">
            <label class="estacion-toggle">
                <input type="checkbox" checked="@esEstacionImpresion" @onchange="ToggleEstacionImpresionAsync" />
                🖨️ Impresora conectada aquí
            </label>
        </div>
    </div>

    @foreach (var solicitud in registroImpresiones)
    {
        <div class="kds-impresion">
            <span>@(solicitud.Impresa ? "🖨️ Imprimiendo" : "ℹ️") comprobante de @solicitud.Solicitud.MesaEtiqueta @(solicitud.Impresa ? "..." : "(esta pantalla no tiene la impresora)")</span>
            <button class="btn btn-sm btn-outline-light" @onclick="() => registroImpresiones.Remove(solicitud)">✕</button>
        </div>
    }

    @if (cargando)
    {
        <p class="p-3"><em>Cargando...</em></p>
    }
    else
    {
        <div class="kds-columnas">
            <div class="kds-columna kds-columna-recibido">
                <div class="kds-columna-header">
                    <span class="kds-columna-titulo">📥 Recibido</span>
                    <span class="kds-columna-contador">@recibidos.Count</span>
                </div>
                <div class="kds-columna-scroll">
                    @if (recibidos.Count == 0)
                    {
                        <p class="kds-vacio">Sin pedidos nuevos</p>
                    }
                    else
                    {
                        @foreach (var ticket in AgruparPorPedido(recibidos))
                        {
                            <div class="kds-ticket">
                                <div class="kds-ticket-header">@ticket.First().MesaEtiqueta</div>
                                @foreach (var item in ticket)
                                {
                                    <div class="kds-item">
                                        <div class="kds-item-info">
                                            <span class="kds-item-cantidad">@item.Cantidad x</span>
                                            <span class="kds-item-nombre">@item.ProductoNombre</span>
                                            @if (item.Modificadores.Count > 0)
                                            {
                                                <div class="kds-item-mods">@string.Join(", ", item.Modificadores)</div>
                                            }
                                            <div class="kds-item-tiempo">⏱ @FormateoTiempo.TiempoTranscurrido(item.FechaCreacion)</div>
                                        </div>
                                        <button class="btn btn-sm kds-btn-recibido" @onclick="() => MarcarEnPreparacionAsync(item.DetallePedidoId)">Recibido</button>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="kds-columna kds-columna-preparacion">
                <div class="kds-columna-header">
                    <span class="kds-columna-titulo">👨‍🍳 En preparación</span>
                    <span class="kds-columna-contador">@enPreparacion.Count</span>
                </div>
                <div class="kds-columna-scroll">
                    @if (enPreparacion.Count == 0)
                    {
                        <p class="kds-vacio">Nada en preparación</p>
                    }
                    else
                    {
                        @foreach (var ticket in AgruparPorPedido(enPreparacion))
                        {
                            <div class="kds-ticket">
                                <div class="kds-ticket-header">@ticket.First().MesaEtiqueta</div>
                                @foreach (var item in ticket)
                                {
                                    <div class="kds-item">
                                        <div class="kds-item-info">
                                            <span class="kds-item-cantidad">@item.Cantidad x</span>
                                            <span class="kds-item-nombre">@item.ProductoNombre</span>
                                            @if (item.Modificadores.Count > 0)
                                            {
                                                <div class="kds-item-mods">@string.Join(", ", item.Modificadores)</div>
                                            }
                                            <div class="kds-item-tiempo">⏱ @FormateoTiempo.TiempoTranscurrido(item.FechaCambioEstado ?? item.FechaCreacion)</div>
                                        </div>
                                        <button class="btn btn-sm btn-success" @onclick="() => MarcarListoAsync(item.DetallePedidoId)">✓ Listo</button>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="kds-columna kds-columna-listo">
                <div class="kds-columna-header">
                    <span class="kds-columna-titulo">✅ Listo</span>
                    <span class="kds-columna-contador">@listos.Count</span>
                </div>
                <div class="kds-columna-scroll">
                    @if (listos.Count == 0)
                    {
                        <p class="kds-vacio">Nada listo todavía</p>
                    }
                    else
                    {
                        @foreach (var ticket in AgruparPorPedido(listos))
                        {
                            <div class="kds-ticket kds-ticket-listo">
                                <div class="kds-ticket-header">@ticket.First().MesaEtiqueta</div>
                                @foreach (var item in ticket)
                                {
                                    <div class="kds-item">
                                        <div class="kds-item-info">
                                            <span class="kds-item-cantidad">@item.Cantidad x</span>
                                            <span class="kds-item-nombre">@item.ProductoNombre</span>
                                            @if (item.Modificadores.Count > 0)
                                            {
                                                <div class="kds-item-mods">@string.Join(", ", item.Modificadores)</div>
                                            }
                                            <div class="kds-item-tiempo">⏱ @FormateoTiempo.TiempoTranscurrido(item.FechaCambioEstado ?? item.FechaCreacion)</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }
</div>

<style>
    .kds-panel {
        padding: 1rem;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .kds-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        border-bottom: 3px solid var(--kds-color);
        padding-bottom: 0.5rem;
        margin-bottom: 1rem;
        flex-shrink: 0;
    }

    .kds-header h1 {
        color: var(--kds-color);
        margin: 0;
    }

    .kds-vacio {
        text-align: center;
        font-size: 1rem;
        color: #999;
        margin-top: 2rem;
    }

    .kds-columnas {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
        flex: 1;
        min-height: 0;
    }

    .kds-columna {
        display: flex;
        flex-direction: column;
        min-height: 0;
        background: #f4f4f4;
        border-radius: 0.6rem;
        overflow: hidden;
    }

    .kds-columna-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.6rem 0.9rem;
        font-weight: 700;
        color: #fff;
        flex-shrink: 0;
    }

    .kds-columna-recibido .kds-columna-header {
        background: #b7472a;
    }

    .kds-columna-preparacion .kds-columna-header {
        background: #b8863b;
    }

    .kds-columna-listo .kds-columna-header {
        background: #3c8a5b;
    }

    .kds-columna-contador {
        background: rgba(255, 255, 255, 0.25);
        border-radius: 1rem;
        padding: 0.1rem 0.6rem;
        font-size: 0.85rem;
    }

    .kds-columna-scroll {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        padding: 0.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .kds-ticket {
        background: #fff;
        border: 1px solid #ddd;
        border-top: 4px solid var(--kds-color);
        border-radius: 0.5rem;
        padding: 0.75rem;
    }

    .kds-ticket-listo {
        opacity: 0.85;
    }

    .kds-ticket-header {
        font-weight: 700;
        font-size: 1.1rem;
        margin-bottom: 0.5rem;
    }

    .kds-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0;
        border-bottom: 1px dashed #eee;
    }

    .kds-item:last-child {
        border-bottom: none;
    }

    .kds-item-cantidad {
        font-weight: 700;
    }

    .kds-item-mods {
        font-size: 0.75rem;
        color: #777;
    }

    .kds-item-tiempo {
        font-size: 0.72rem;
        color: #999;
        margin-top: 0.15rem;
    }

    .kds-btn-recibido {
        background: var(--kds-color);
        color: #fff;
        border: none;
        white-space: nowrap;
    }

    .kds-impresion {
        background: var(--kds-color);
        color: #fff;
        border-radius: 0.5rem;
        padding: 0.6rem 0.9rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-bottom: 0.75rem;
        flex-wrap: wrap;
        flex-shrink: 0;
    }

    .estacion-toggle {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.82rem;
        color: #666;
        cursor: pointer;
        user-select: none;
    }

    /* En pantallas angostas las tres columnas no entran una al lado de la otra: se apilan y
       cada una conserva su propio scroll interno con una altura fija para no perder de vista
       las otras columnas debajo. */
    @@media (max-width: 900px) {
        .kds-columnas {
            grid-template-columns: 1fr;
            overflow-y: auto;
        }

        .kds-columna {
            flex: none;
        }

        .kds-columna-scroll {
            max-height: 60vh;
        }
    }
</style>

@code {
    [Parameter, EditorRequired]
    public DestinoPreparacion Destino { get; set; }

    [Parameter, EditorRequired]
    public string Titulo { get; set; } = "";

    [Parameter]
    public string Color { get; set; } = "#650610";

    private bool cargando = true;
    private bool esEstacionImpresion;
    private List<ItemKds> items = [];
    private List<RegistroImpresion> registroImpresiones = [];
    private DotNetObjectReference<KdsPanel>? referencia;
    private int? tokenPedidoActualizado;
    private int? tokenSolicitudImpresion;

    // "items" ya llega ordenado por lo más reciente primero (ver PedidoService.ListarParaKdsAsync),
    // así que estos Where conservan ese orden y cada columna muestra sus tickets más nuevos arriba.
    private List<ItemKds> recibidos => items.Where(i => i.Estado == EstadoDetallePedido.Recibido).ToList();
    private List<ItemKds> enPreparacion => items.Where(i => i.Estado == EstadoDetallePedido.EnPreparacion).ToList();
    private List<ItemKds> listos => items.Where(i => i.Estado == EstadoDetallePedido.Listo).ToList();

    private static List<IGrouping<int, ItemKds>> AgruparPorPedido(IEnumerable<ItemKds> lista) =>
        lista.GroupBy(i => i.PedidoId).ToList();

    protected override async Task OnInitializedAsync() => await CargarAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        referencia = DotNetObjectReference.Create(this);
        tokenPedidoActualizado = await JS.InvokeAsync<int>("comandaHub.subscribe", ComandaEventos.PedidoActualizado, referencia, nameof(OnPedidoActualizado));
        tokenSolicitudImpresion = await JS.InvokeAsync<int>("comandaHub.subscribe", ComandaEventos.SolicitudImpresion, referencia, nameof(OnSolicitudImpresion));
        esEstacionImpresion = await JS.InvokeAsync<bool>("comandaHub.esEstacionDeImpresion");
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnPedidoActualizado()
    {
        await CargarAsync();
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnSolicitudImpresion(SolicitudImpresion solicitud)
    {
        if (esEstacionImpresion)
            await JS.InvokeVoidAsync("comandaHub.imprimirSilencioso", solicitud.PedidoId);

        registroImpresiones.Add(new RegistroImpresion { Solicitud = solicitud, Impresa = esEstacionImpresion });
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleEstacionImpresionAsync(ChangeEventArgs e)
    {
        esEstacionImpresion = (bool)e.Value!;
        await JS.InvokeVoidAsync("comandaHub.marcarEstacionDeImpresion", esEstacionImpresion);
    }

    private async Task CargarAsync()
    {
        cargando = true;
        items = await PedidoService.ListarParaKdsAsync(Destino);
        cargando = false;
    }

    private async Task MarcarEnPreparacionAsync(int detallePedidoId)
    {
        await PedidoService.MarcarEnPreparacionAsync(detallePedidoId);
        await CargarAsync();
    }

    private async Task MarcarListoAsync(int detallePedidoId)
    {
        await PedidoService.MarcarListoAsync(detallePedidoId);
        await CargarAsync();
    }

    public async ValueTask DisposeAsync()
    {
        referencia?.Dispose();

        try
        {
            if (tokenPedidoActualizado is { } tokenPedido)
                await JS.InvokeVoidAsync("comandaHub.unsubscribe", tokenPedido);
            if (tokenSolicitudImpresion is { } tokenImpresion)
                await JS.InvokeVoidAsync("comandaHub.unsubscribe", tokenImpresion);
        }
        catch (JSDisconnectedException)
        {
            // El circuito ya se cerró (ej. el usuario cerró la pestaña): no hay a quién avisar.
        }
    }

    private class RegistroImpresion
    {
        public required SolicitudImpresion Solicitud { get; init; }
        public bool Impresa { get; init; }
    }
}
