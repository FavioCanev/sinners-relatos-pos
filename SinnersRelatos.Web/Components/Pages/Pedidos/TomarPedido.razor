</style>

@code {
    [Parameter]
    public int MesaId { get; set; }

    private bool cargando = true;
    private Mesa? mesa;
    private UsuarioSesion? usuario;
    private Pedido? pedido;
    private List<DetallePedido> yaConfirmados = [];
    private List<Producto> productos = [];
    private Dictionary<int, bool> disponibilidad = [];

    private string busqueda = "";
    private Marca marcaSeleccionada = Marca.Sinners;
    private int? categoriaSeleccionadaId;
    private string? mensajeError;
    private bool confirmandoAnulacion;
    private bool confirmandoCierre;
    private bool solicitandoImpresion;
    private bool impresionSolicitada;

    private List<LineaCarrito> carrito = [];
    private bool mostrandoCarrito;
    private bool confirmando;

    private Producto? productoModal;
    private HashSet<int> opcionesSeleccionadasModal = [];
    private bool forzarVentaModal;
    private int cantidadModal = 1;
    private string? mensajeErrorModal;
    private Dictionary<int, bool> disponibilidadOpciones = [];
    private bool agotadoModal => productoModal is not null && (
        (disponibilidad.TryGetValue(productoModal.Id, out var disp) && !disp) ||
        opcionesSeleccionadasModal.Any(id => disponibilidadOpciones.TryGetValue(id, out var dispOpcion) && !dispOpcion));

    private DotNetObjectReference<TomarPedido>? referenciaHub;

    private IEnumerable<Producto> ProductosVisibles =>
        string.IsNullOrWhiteSpace(busqueda)
            ? productos.Where(p => p.Marca == marcaSeleccionada && (categoriaSeleccionadaId == null || p.CategoriaId == categoriaSeleccionadaId))
            : productos.Where(p => p.Nombre.Contains(busqueda, StringComparison.OrdinalIgnoreCase));

    private List<Categoria> CategoriasDeMarca(Marca marca) =>
        productos.Where(p => p.Marca == marca).Select(p => p.Categoria).DistinctBy(c => c.Id).OrderBy(c => c.Nombre).ToList();

    protected override async Task OnInitializedAsync()
    {
        var usuarioSesion = await SesionService.ObtenerUsuarioActualAsync();
        if (usuarioSesion is null)
        {
            Navigation.NavigateTo($"/login?returnUrl=/pedido/mesa/{MesaId}");
            return;
        }
        usuario = usuarioSesion;

        mesa = await MesaService.ObtenerPorIdAsync(MesaId);
        if (mesa is null)
        {
            cargando = false;
            return;
        }

        marcaSeleccionada = mesa.Marca;

        pedido = await PedidoService.ObtenerOCrearPedidoAsync(MesaId, usuario.Id);
        await CargarDetallePedidoAsync();

        productos = await ProductoService.ListarAsync();
        disponibilidad = await PedidoService.VerificarDisponibilidadAsync(productos.Select(p => p.Id));

        var opcionIds = productos
            .SelectMany(p => p.GruposModificadores.SelectMany(g => g.GrupoModificador.Opciones.Select(o => o.Id)))
            .Distinct();
        disponibilidadOpciones = await PedidoService.VerificarDisponibilidadOpcionesAsync(opcionIds);

        categoriaSeleccionadaId = CategoriasDeMarca(marcaSeleccionada).FirstOrDefault()?.Id;

        cargando = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        referenciaHub = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("comandaHub.subscribe", ComandaEventos.PedidoActualizado, referenciaHub, nameof(OnPedidoActualizado));
    }

    [JSInvokable]
    public async Task OnPedidoActualizado()
    {
        await CargarDetallePedidoAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CargarDetallePedidoAsync()
    {
        if (pedido is null)
            return;

        var completo = await PedidoService.ObtenerConDetalleAsync(pedido.Id);
        yaConfirmados = completo?.Detalles.ToList() ?? [];
    }

    private void SeleccionarMarca(Marca marca)
    {
        marcaSeleccionada = marca;
        categoriaSeleccionadaId = CategoriasDeMarca(marca).FirstOrDefault()?.Id;
    }

    private void OnProductoTap(Producto producto)
    {
        var tieneModificadores = producto.GruposModificadores.Count > 0;
        var agotado = disponibilidad.TryGetValue(producto.Id, out var disp) && !disp;

        if (tieneModificadores || agotado)
        {
            productoModal = producto;
            opcionesSeleccionadasModal = [];
            forzarVentaModal = false;
            cantidadModal = 1;
            mensajeErrorModal = null;
        }
        else
        {
            AgregarAlCarrito(producto, [], false, 1);
        }
    }

    private void CerrarModal() => productoModal = null;

    private void ToggleOpcionModal(GrupoModificador grupo, OpcionModificador opcion)
    {
        if (!grupo.PermiteMultiple)
        {
            foreach (var o in grupo.Opciones)
                opcionesSeleccionadasModal.Remove(o.Id);

            opcionesSeleccionadasModal.Add(opcion.Id);
            return;
        }

        if (!opcionesSeleccionadasModal.Add(opcion.Id))
            opcionesSeleccionadasModal.Remove(opcion.Id);
    }

    private void ConfirmarModal()
    {
        if (productoModal is null)
            return;

        foreach (var vinculo in productoModal.GruposModificadores)
        {
            var grupo = vinculo.GrupoModificador;
            if (grupo.EsObligatorio && !grupo.Opciones.Any(o => opcionesSeleccionadasModal.Contains(o.Id)))
            {
                mensajeErrorModal = $"Selecciona una opción de '{grupo.Nombre}'.";
                return;
            }
        }

        if (agotadoModal && !forzarVentaModal)
        {
            mensajeErrorModal = "Marca 'Forzar venta' para agregar este producto sin stock suficiente.";
            return;
        }

        var opciones = productoModal.GruposModificadores
            .SelectMany(g => g.GrupoModificador.Opciones)
            .Where(o => opcionesSeleccionadasModal.Contains(o.Id))
            .ToList();

        AgregarAlCarrito(productoModal, opciones, agotadoModal && forzarVentaModal, cantidadModal);
        CerrarModal();
    }

    private void AgregarAlCarrito(Producto producto, List<OpcionModificador> opciones, bool forzar, int cantidad)
    {
        var opcionIds = opciones.Select(o => o.Id).OrderBy(x => x).ToList();
        var existente = carrito.FirstOrDefault(l => l.Producto.Id == producto.Id
            && l.ForzarVenta == forzar
            && l.OpcionesSeleccionadas.Select(o => o.Id).OrderBy(x => x).SequenceEqual(opcionIds));

        if (existente is not null)
            existente.Cantidad += cantidad;
        else
            carrito.Add(new LineaCarrito { Producto = producto, OpcionesSeleccionadas = opciones, ForzarVenta = forzar, Cantidad = cantidad });
    }

    private void CambiarCantidad(LineaCarrito linea, int delta)
    {
        linea.Cantidad += delta;
        if (linea.Cantidad <= 0)
            carrito.Remove(linea);
    }

    private async Task ConfirmarPedidoAsync()
    {
        if (pedido is null || carrito.Count == 0)
            return;

        confirmando = true;
        try
        {
            var items = carrito.Select(l => new ItemCarrito
            {
                ProductoId = l.Producto.Id,
                Cantidad = l.Cantidad,
                OpcionModificadorIds = l.OpcionesSeleccionadas.Select(o => o.Id).ToList(),
                ForzarVenta = l.ForzarVenta
            });

            await PedidoService.ConfirmarItemsAsync(pedido.Id, items, usuario!.Id);
            carrito.Clear();
            mostrandoCarrito = false;
            mensajeError = null;

            await CargarDetallePedidoAsync();
            disponibilidad = await PedidoService.VerificarDisponibilidadAsync(productos.Select(p => p.Id));
        }
        catch (InvalidOperationException ex)
        {
            mensajeError = ex.Message;
        }
        finally
        {
            confirmando = false;
        }
    }

    private async Task AnularPedidoAsync()
    {
        if (pedido is null)
            return;

        await PedidoService.AnularAsync(pedido.Id, usuario!.Id);
        Navigation.NavigateTo($"/mesas/{mesa!.Marca.ToString().ToLowerInvariant()}");
    }

    private async Task CerrarCuentaAsync()
    {
        if (pedido is null)
            return;

        await PedidoService.CerrarAsync(pedido.Id, usuario!.Id);
        Navigation.NavigateTo($"/mesas/{mesa!.Marca.ToString().ToLowerInvariant()}");
    }

    private async Task SolicitarImpresionAsync()
    {
        if (pedido is null)
            return;

        solicitandoImpresion = true;
        await PedidoService.SolicitarImpresionAsync(pedido.Id);
        solicitandoImpresion = false;
        impresionSolicitada = true;
    }

    public ValueTask DisposeAsync()
    {
        referenciaHub?.Dispose();
        return ValueTask.CompletedTask;
    }

    private class LineaCarrito
    {
        public required Producto Producto { get; init; }
        public int Cantidad { get; set; } = 1;
        public List<OpcionModificador> OpcionesSeleccionadas { get; set; } = [];
        public bool ForzarVenta { get; set; }
        public decimal Subtotal => Cantidad * (Producto.Precio + OpcionesSeleccionadas.Sum(o => o.PrecioAdicional));
    }
}
