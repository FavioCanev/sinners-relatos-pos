@code {
    [Parameter]
    public int MesaId { get; set; }

    private bool cargando = true;
    private Mesa? mesa;
    private UsuarioSesion? usuario;
    private Pedido? pedido;
    private List<DetallePedido> yaConfirmados = [];
    private List<Producto> productos = [];
    private Dictionary<int, bool> disponibilidad = [];

    private string busqueda = "";
    private Marca marcaSeleccionada = Marca.Sinners;
    private int? categoriaSeleccionadaId;
    private string? mensajeError;
    private bool confirmandoAnulacion;
    private bool confirmandoCierre;
    private MedioPago? medioPagoSeleccionado;
    private bool cerrandoCuenta;
    private bool solicitandoImpresion;
    private bool impresionSolicitada;
    private int? detalleEliminando;
    private bool eliminandoItem;

    private List<LineaCarrito> carrito = [];
    private bool mostrandoCarrito;
    private bool confirmando;

    private bool mostrandoPresets;
    private List<Preset> presets = [];
    private bool cargandoPresets;
    private bool mostrandoEditorPreset;
    private Preset? presetEditando;
    private string nombrePresetForm = "";
    private List<ItemPresetForm> itemsPresetForm = [];
    private int? productoParaAgregarId;
    private int cantidadParaAgregar = 1;
    private Marca? presetFiltroMarca;
    private int? presetFiltroCategoriaId;
    private string? mensajeErrorPreset;
    private bool guardandoPreset;
    private int? presetDesactivando;
    private bool desactivandoPreset;
    private Queue<(Producto Producto, int Cantidad)>? colaPreset;

    private System.Timers.Timer? temporizador;

    private string? toastMensaje;
    private System.Timers.Timer? toastTimer;

    private DateTime? TiempoActivoDesde => yaConfirmados.Count > 0 ? yaConfirmados.Min(d => d.FechaCreacion) : null;

    private Producto? productoModal;
    private HashSet<int> opcionesSeleccionadasModal = [];
    private bool forzarVentaModal;
    private int cantidadModal = 1;
    private string? mensajeErrorModal;
    private Dictionary<int, bool> disponibilidadOpciones = [];
    private bool agotadoModal => productoModal is not null && (
        (disponibilidad.TryGetValue(productoModal.Id, out var disp) && !disp) ||
        opcionesSeleccionadasModal.Any(id => disponibilidadOpciones.TryGetValue(id, out var dispOpcion) && !dispOpcion));

    private DotNetObjectReference<TomarPedido>? referenciaHub;
    private int? tokenSuscripcion;

    private IEnumerable<Producto> ProductosVisibles =>
        string.IsNullOrWhiteSpace(busqueda)
            ? productos.Where(p => p.Marca == marcaSeleccionada && (categoriaSeleccionadaId == null || p.CategoriaId == categoriaSeleccionadaId))
            : productos.Where(p => p.Nombre.Contains(busqueda, StringComparison.OrdinalIgnoreCase));

    private List<Categoria> CategoriasDeMarca(Marca marca) =>
        productos.Where(p => p.Marca == marca).Select(p => p.Categoria).DistinctBy(c => c.Id).OrderBy(c => c.Nombre).ToList();

    private List<Categoria> CategoriasParaPreset =>
        (presetFiltroMarca is { } marca ? productos.Where(p => p.Marca == marca) : productos)
            .Select(p => p.Categoria).DistinctBy(c => c.Id).OrderBy(c => c.Nombre).ToList();

    private IEnumerable<Producto> ProductosParaPreset =>
        productos.Where(p => p.Activo
            && (presetFiltroMarca is null || p.Marca == presetFiltroMarca)
            && (presetFiltroCategoriaId is null || p.CategoriaId == presetFiltroCategoriaId))
            .OrderBy(p => p.Nombre);

    private IEnumerable<Preset> PresetsVisibles =>
        string.IsNullOrWhiteSpace(busqueda)
            ? presets
            : presets.Where(p => p.Nombre.Contains(busqueda, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        usuario = await SesionService.ObtenerUsuarioActualAsync();
        if (usuario is null)
        {
            Navigation.NavigateTo($"/login?returnUrl=/pedido/mesa/{MesaId}");
            return;
        }

        mesa = await MesaService.ObtenerPorIdAsync(MesaId);
        if (mesa is null)
        {
            cargando = false;
            return;
        }

        marcaSeleccionada = mesa.Marca;

        pedido = await PedidoService.ObtenerOCrearPedidoAsync(MesaId, usuario!.Id);
        await CargarDetallePedidoAsync();

        productos = await ProductoService.ListarAsync();
        disponibilidad = await PedidoService.VerificarDisponibilidadAsync(productos.Select(p => p.Id));

        categoriaSeleccionadaId = CategoriasDeMarca(marcaSeleccionada).FirstOrDefault()?.Id;

        cargando = false;

        // Refresca el contador de tiempo activo cada 30s. No hace falta recargar nada del
        // servidor: TiempoActivoDesde ya está en memoria, solo se vuelve a pintar.
        temporizador = new System.Timers.Timer(30_000);
        temporizador.Elapsed += async (_, _) => await InvokeAsync(StateHasChanged);
        temporizador.Start();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        referenciaHub = DotNetObjectReference.Create(this);
        tokenSuscripcion = await JS.InvokeAsync<int>("comandaHub.subscribe", ComandaEventos.PedidoActualizado, referenciaHub, nameof(OnPedidoActualizado));
    }

    [JSInvokable]
    public async Task OnPedidoActualizado()
    {
        await CargarDetallePedidoAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CargarDetallePedidoAsync()
    {
        if (pedido is null)
            return;

        var completo = await PedidoService.ObtenerConDetalleAsync(pedido.Id);
        yaConfirmados = completo?.Detalles.ToList() ?? [];
    }

    private void SeleccionarMarca(Marca marca)
    {
        marcaSeleccionada = marca;
        categoriaSeleccionadaId = CategoriasDeMarca(marca).FirstOrDefault()?.Id;
        mostrandoPresets = false;
    }

    private async Task MostrarPresetsAsync()
    {
        mostrandoPresets = true;
        cargandoPresets = true;
        presets = await PresetService.ListarAsync();
        cargandoPresets = false;
    }

    private async Task AgregarPresetAlCarrito(Preset preset)
    {
        // Los productos del combo que tienen modificadores (obligatorios u opcionales) o que
        // están sin stock pasan por el mismo modal que si se agregaran uno por uno; el resto se
        // agrega directo, igual que antes.
        var pendientes = new Queue<(Producto Producto, int Cantidad)>();
        var huboAgregadoDirecto = false;

        foreach (var item in preset.Productos)
        {
            // PresetService no carga GruposModificadores del producto (no lo necesita para
            // mostrar el combo), así que se usa la instancia ya cargada en esta página — la
            // misma que usa el grid de productos — para saber si corresponde abrir el modal.
            var producto = productos.FirstOrDefault(p => p.Id == item.ProductoId) ?? item.Producto;
            var tieneModificadores = producto.GruposModificadores.Count > 0;
            var agotado = disponibilidad.TryGetValue(producto.Id, out var disp) && !disp;

            if (tieneModificadores || agotado)
            {
                pendientes.Enqueue((producto, item.Cantidad));
            }
            else
            {
                AgregarAlCarrito(producto, [], false, item.Cantidad, mostrarToast: false);
                huboAgregadoDirecto = true;
            }
        }

        if (pendientes.Count == 0)
        {
            if (huboAgregadoDirecto)
                MostrarToast($"✓ {preset.Nombre}");
            return;
        }

        colaPreset = pendientes;
        await AbrirSiguienteDelPresetAsync();
    }

    private async Task AbrirSiguienteDelPresetAsync()
    {
        if (colaPreset is null || colaPreset.Count == 0)
        {
            colaPreset = null;
            return;
        }

        var (producto, cantidad) = colaPreset.Dequeue();
        await AbrirModalProductoAsync(producto, cantidad);
    }

    private void AbrirNuevoPreset()
    {
        presetEditando = null;
        nombrePresetForm = "";
        itemsPresetForm = [];
        productoParaAgregarId = null;
        cantidadParaAgregar = 1;
        presetFiltroMarca = null;
        presetFiltroCategoriaId = null;
        mensajeErrorPreset = null;
        mostrandoEditorPreset = true;
    }

    private void AbrirEditarPreset(Preset preset)
    {
        presetEditando = preset;
        nombrePresetForm = preset.Nombre;
        itemsPresetForm = preset.Productos.Select(pp => new ItemPresetForm { Producto = pp.Producto, Cantidad = pp.Cantidad }).ToList();
        productoParaAgregarId = null;
        cantidadParaAgregar = 1;
        presetFiltroMarca = null;
        presetFiltroCategoriaId = null;
        mensajeErrorPreset = null;
        presetDesactivando = null;
        mostrandoEditorPreset = true;
    }

    private void CerrarEditorPreset() => mostrandoEditorPreset = false;

    private void OnFiltroMarcaPresetChange(ChangeEventArgs e)
    {
        presetFiltroMarca = Enum.TryParse<Marca>(e.Value?.ToString(), out var marca) ? marca : null;
        presetFiltroCategoriaId = null;
    }

    private void OnFiltroCategoriaPresetChange(ChangeEventArgs e) =>
        presetFiltroCategoriaId = int.TryParse(e.Value?.ToString(), out var id) ? id : null;

    private void OnProductoParaAgregarChange(ChangeEventArgs e) =>
        productoParaAgregarId = int.TryParse(e.Value?.ToString(), out var id) ? id : null;

    private void AgregarProductoAlPreset()
    {
        if (productoParaAgregarId is not { } id)
            return;

        var producto = productos.FirstOrDefault(p => p.Id == id);
        if (producto is null)
            return;

        var existente = itemsPresetForm.FirstOrDefault(i => i.Producto.Id == id);
        if (existente is not null)
            existente.Cantidad += cantidadParaAgregar;
        else
            itemsPresetForm.Add(new ItemPresetForm { Producto = producto, Cantidad = cantidadParaAgregar });

        productoParaAgregarId = null;
        cantidadParaAgregar = 1;
    }

    private void QuitarProductoDelPreset(ItemPresetForm item) => itemsPresetForm.Remove(item);

    private decimal TotalPresetForm => itemsPresetForm.Sum(i => i.Producto.Precio * i.Cantidad);

    private async Task GuardarPresetAsync()
    {
        if (string.IsNullOrWhiteSpace(nombrePresetForm))
        {
            mensajeErrorPreset = "Ingresa un nombre para el combo.";
            return;
        }
        if (itemsPresetForm.Count == 0)
        {
            mensajeErrorPreset = "Agrega al menos un producto.";
            return;
        }

        guardandoPreset = true;
        mensajeErrorPreset = null;
        try
        {
            var cantidades = itemsPresetForm.ToDictionary(i => i.Producto.Id, i => i.Cantidad);
            if (presetEditando is null)
                await PresetService.CrearAsync(nombrePresetForm.Trim(), cantidades, usuario!.Id);
            else
                await PresetService.ActualizarAsync(presetEditando.Id, nombrePresetForm.Trim(), cantidades, usuario!.Id);

            mostrandoEditorPreset = false;
            presets = await PresetService.ListarAsync();
        }
        catch (InvalidOperationException ex)
        {
            mensajeErrorPreset = ex.Message;
        }
        finally
        {
            guardandoPreset = false;
        }
    }

    private async Task DesactivarPresetAsync(int presetId)
    {
        desactivandoPreset = true;
        await PresetService.CambiarEstadoAsync(presetId, false, usuario!.Id);
        presets = await PresetService.ListarAsync();
        presetDesactivando = null;
        desactivandoPreset = false;
        mostrandoEditorPreset = false;
    }

    private async Task OnProductoTapAsync(Producto producto)
    {
        var tieneModificadores = producto.GruposModificadores.Count > 0;
        var agotado = disponibilidad.TryGetValue(producto.Id, out var disp) && !disp;

        if (tieneModificadores || agotado)
            await AbrirModalProductoAsync(producto, 1);
        else
            AgregarAlCarrito(producto, [], false, 1);
    }

    private async Task AbrirModalProductoAsync(Producto producto, int cantidad)
    {
        productoModal = producto;
        opcionesSeleccionadasModal = [];
        forzarVentaModal = false;
        cantidadModal = cantidad;
        mensajeErrorModal = null;

        var opcionIds = producto.GruposModificadores
            .SelectMany(g => g.GrupoModificador.Opciones.Select(o => o.Id))
            .Distinct();
        disponibilidadOpciones = await PedidoService.VerificarDisponibilidadOpcionesAsync(producto.Id, opcionIds);
    }

    private void CerrarModal()
    {
        // Si se estaba resolviendo los modificadores de un combo y el usuario cierra el modal a
        // mano (X, tocar fuera), se cancela el resto de la cola: lo que ya se agregó queda en el
        // carrito, pero no se sigue preguntando por los productos del combo que faltaban.
        productoModal = null;
        colaPreset = null;
    }

    private void ToggleOpcionModal(GrupoModificador grupo, OpcionModificador opcion)
    {
        if (!grupo.PermiteMultiple)
        {
            foreach (var o in grupo.Opciones)
                opcionesSeleccionadasModal.Remove(o.Id);

            opcionesSeleccionadasModal.Add(opcion.Id);
            return;
        }

        if (!opcionesSeleccionadasModal.Add(opcion.Id))
            opcionesSeleccionadasModal.Remove(opcion.Id);
    }

    private async Task ConfirmarModal()
    {
        if (productoModal is null)
            return;

        foreach (var vinculo in productoModal.GruposModificadores)
        {
            var grupo = vinculo.GrupoModificador;
            if (grupo.EsObligatorio && !grupo.Opciones.Any(o => opcionesSeleccionadasModal.Contains(o.Id)))
            {
                mensajeErrorModal = $"Selecciona una opción de '{grupo.Nombre}'.";
                return;
            }
        }

        if (agotadoModal && !forzarVentaModal)
        {
            mensajeErrorModal = "Marca 'Forzar venta' para agregar este producto sin stock suficiente.";
            return;
        }

        var opciones = productoModal.GruposModificadores
            .SelectMany(g => g.GrupoModificador.Opciones)
            .Where(o => opcionesSeleccionadasModal.Contains(o.Id))
            .ToList();

        AgregarAlCarrito(productoModal, opciones, agotadoModal && forzarVentaModal, cantidadModal);
        productoModal = null;

        // Si venimos de un combo, seguimos con el siguiente producto que necesite modificadores
        // en vez de cerrar del todo.
        if (colaPreset is not null)
            await AbrirSiguienteDelPresetAsync();
    }

    private void AgregarAlCarrito(Producto producto, List<OpcionModificador> opciones, bool forzar, int cantidad, bool mostrarToast = true)
    {
        var opcionIds = opciones.Select(o => o.Id).OrderBy(x => x).ToList();
        var existente = carrito.FirstOrDefault(l => l.Producto.Id == producto.Id
            && l.ForzarVenta == forzar
            && l.OpcionesSeleccionadas.Select(o => o.Id).OrderBy(x => x).SequenceEqual(opcionIds));

        if (existente is not null)
            existente.Cantidad += cantidad;
        else
            carrito.Add(new LineaCarrito { Producto = producto, OpcionesSeleccionadas = opciones, ForzarVenta = forzar, Cantidad = cantidad });

        if (mostrarToast)
            MostrarToast($"✓ {producto.Nombre}");
    }

    // Aviso breve al agregar algo al carrito: antes el único indicio era la barra del carrito
    // apareciendo/actualizándose abajo, poco perceptible si no se mira hacia allá justo al tocar.
    private void MostrarToast(string mensaje)
    {
        toastMensaje = mensaje;

        toastTimer?.Stop();
        toastTimer?.Dispose();
        toastTimer = new System.Timers.Timer(1200) { AutoReset = false };
        toastTimer.Elapsed += async (_, _) =>
        {
            toastMensaje = null;
            await InvokeAsync(StateHasChanged);
        };
        toastTimer.Start();
    }

    private void CambiarCantidad(LineaCarrito linea, int delta)
    {
        linea.Cantidad += delta;
        if (linea.Cantidad <= 0)
            carrito.Remove(linea);
    }

    private async Task ConfirmarPedidoAsync()
    {
        if (pedido is null || carrito.Count == 0)
            return;

        confirmando = true;
        try
        {
            var items = carrito.Select(l => new ItemCarrito
            {
                ProductoId = l.Producto.Id,
                Cantidad = l.Cantidad,
                OpcionModificadorIds = l.OpcionesSeleccionadas.Select(o => o.Id).ToList(),
                ForzarVenta = l.ForzarVenta
            });

            await PedidoService.ConfirmarItemsAsync(pedido.Id, items, usuario!.Id);
            carrito.Clear();
            mostrandoCarrito = false;
            mensajeError = null;

            await CargarDetallePedidoAsync();
            disponibilidad = await PedidoService.VerificarDisponibilidadAsync(productos.Select(p => p.Id));
        }
        catch (InvalidOperationException ex)
        {
            mensajeError = ex.Message;
        }
        finally
        {
            confirmando = false;
        }
    }

    private async Task EliminarItemAsync(int detallePedidoId)
    {
        eliminandoItem = true;
        mensajeError = null;
        try
        {
            await PedidoService.EliminarItemAsync(detallePedidoId, usuario!.Id);
            await CargarDetallePedidoAsync();
            disponibilidad = await PedidoService.VerificarDisponibilidadAsync(productos.Select(p => p.Id));
        }
        catch (InvalidOperationException ex)
        {
            mensajeError = ex.Message;
        }
        finally
        {
            detalleEliminando = null;
            eliminandoItem = false;
        }
    }

    private async Task AnularPedidoAsync()
    {
        if (pedido is null)
            return;

        await PedidoService.AnularAsync(pedido.Id, usuario!.Id);
        Navigation.NavigateTo($"/mesas/{mesa!.Marca.ToString().ToLowerInvariant()}");
    }

    private void AbrirConfirmacionCierre()
    {
        confirmandoCierre = true;
        medioPagoSeleccionado = null;
    }

    private void OnMedioPagoChange(ChangeEventArgs e) =>
        medioPagoSeleccionado = Enum.TryParse<MedioPago>(e.Value?.ToString(), out var medio) ? medio : null;

    private async Task CerrarCuentaAsync()
    {
        if (pedido is null || medioPagoSeleccionado is not { } medio)
            return;

        cerrandoCuenta = true;
        await PedidoService.CerrarAsync(pedido.Id, medio, usuario!.Id);
        Navigation.NavigateTo($"/mesas/{mesa!.Marca.ToString().ToLowerInvariant()}");
    }

    private async Task SolicitarImpresionAsync()
    {
        if (pedido is null)
            return;

        solicitandoImpresion = true;
        await PedidoService.SolicitarImpresionAsync(pedido.Id);
        solicitandoImpresion = false;
        impresionSolicitada = true;
    }

    public async ValueTask DisposeAsync()
    {
        referenciaHub?.Dispose();
        temporizador?.Dispose();
        toastTimer?.Dispose();

        if (tokenSuscripcion is { } token)
        {
            try
            {
                await JS.InvokeVoidAsync("comandaHub.unsubscribe", token);
            }
            catch (JSDisconnectedException)
            {
                // El circuito ya se cerró (ej. el usuario cerró la pestaña o navegó fuera):
                // no hay a quién avisar ni falta hacerlo.
            }
        }
    }

    private class LineaCarrito
    {
        public required Producto Producto { get; init; }
        public int Cantidad { get; set; } = 1;
        public List<OpcionModificador> OpcionesSeleccionadas { get; set; } = [];
        public bool ForzarVenta { get; set; }
        public decimal Subtotal => Cantidad * (Producto.Precio + OpcionesSeleccionadas.Sum(o => o.PrecioAdicional));
    }

    private class ItemPresetForm
    {
        public required Producto Producto { get; init; }
        public int Cantidad { get; set; } = 1;
    }
}
