@page "/pedido/mesa/{MesaId:int}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SinnersRelatos.Web.Hubs
@using SinnersRelatos.Web.Models
@using SinnersRelatos.Web.Services.Interfaces
@inject IMesaService MesaService
@inject IProductoService ProductoService
@inject IPedidoService PedidoService
@inject ISesionService SesionService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Tomar Pedido</PageTitle>

@if (cargando)
{
    <p class="p-3"><em>Cargando...</em></p>
}
else if (mesa is null)
{
    <p class="p-3 text-danger">Mesa no encontrada.</p>
}
else
{
    <div class="pedido-header">
        <a href="/mesas/@mesa.Marca.ToString().ToLowerInvariant()" class="volver">&larr;</a>
        <div>
            <div class="mesa-titulo">@(mesa.Tipo == TipoMesa.Barra ? "Barra" : "Mesa") @mesa.Numero — @mesa.Marca</div>
            <div class="mesero-nombre">@usuario?.NombreCompleto</div>
        </div>
        @if (confirmandoCierre)
        {
            <div class="ms-auto d-flex gap-1">
                <span class="text-success small align-self-center">¿Cerrar cuenta y liberar la mesa?</span>
                <button class="btn btn-sm btn-success" @onclick="CerrarCuentaAsync">Sí, cerrar</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => confirmandoCierre = false">No</button>
            </div>
        }
        else if (confirmandoAnulacion)
        {
            <div class="ms-auto d-flex gap-1">
                <span class="text-danger small align-self-center">¿Seguro?</span>
                <button class="btn btn-sm btn-danger" @onclick="AnularPedidoAsync">Sí, anular</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => confirmandoAnulacion = false">No</button>
            </div>
        }
        else
        {
            <div class="ms-auto d-flex gap-1">
                <button class="btn btn-sm btn-success" @onclick="() => confirmandoCierre = true">Cerrar cuenta</button>
                <button class="btn btn-sm btn-outline-danger" @onclick="() => confirmandoAnulacion = true">Anular pedido</button>
            </div>
        }
    </div>

    @if (yaConfirmados.Count > 0)
    {
        <div class="ya-pedido">
            <strong>Ya en el pedido:</strong>
            <ul class="mb-0">
                @foreach (var d in yaConfirmados)
                {
                    <li class="@(d.Estado == EstadoDetallePedido.Listo ? "item-listo" : "")">
                        @d.Cantidad x @d.Producto.Nombre @(d.Modificadores.Count > 0 ? $"({string.Join(", ", d.Modificadores.Select(m => m.OpcionModificador.Nombre))})" : "")
                        @if (d.Estado == EstadoDetallePedido.Listo)
                        {
                            <span class="badge-listo">✅ Listo para recoger</span>
                        }
                    </li>
                }
            </ul>
            <div class="d-flex gap-2 mt-2">
                <a class="btn btn-sm btn-outline-secondary" href="/print/comprobante/@(pedido!.Id)?autoprint=false" target="_blank">🧾 Ver / Guardar PDF</a>
                <button class="btn btn-sm btn-outline-secondary" @onclick="SolicitarImpresionAsync" disabled="@solicitandoImpresion">
                    🖨️ @(solicitandoImpresion ? "Enviando..." : "Imprimir en cocina/barra")
                </button>
            </div>
            @if (impresionSolicitada)
            {
                <div class="text-success small mt-1">Solicitud enviada a las pantallas de cocina y barra.</div>
            }
        </div>
    }

    <div class="p-2">
        <input class="form-control" placeholder="Buscar en el menú..." @bind="busqueda" @bind:event="oninput" />
    </div>

    @if (string.IsNullOrWhiteSpace(busqueda))
    {
        <div class="marca-tabs">
            <button class="marca-tab @(marcaSeleccionada == Marca.Sinners ? "activa" : "")" @onclick="() => SeleccionarMarca(Marca.Sinners)">Sinners</button>
            <button class="marca-tab @(marcaSeleccionada == Marca.Relatos ? "activa" : "")" @onclick="() => SeleccionarMarca(Marca.Relatos)">Relatos</button>
        </div>

        <div class="categoria-chips">
            @foreach (var categoria in CategoriasDeMarca(marcaSeleccionada))
            {
                <button class="chip @(categoriaSeleccionadaId == categoria.Id ? "chip-activo" : "")" @onclick="() => categoriaSeleccionadaId = categoria.Id">
                    @categoria.Nombre
                </button>
            }
        </div>
    }

    @if (mensajeError is not null)
    {
        <div class="alert alert-danger mx-2 py-2">
            @mensajeError
            <button type="button" class="btn-close float-end" @onclick="() => mensajeError = null"></button>
        </div>
    }

    <div class="productos-grid">
        @foreach (var producto in ProductosVisibles)
        {
            var agotado = disponibilidad.TryGetValue(producto.Id, out var disp) && !disp;
            <button class="producto-card @(agotado ? "agotado" : "")" @onclick="() => OnProductoTap(producto)">
                <span class="producto-nombre">@producto.Nombre</span>
                <span class="producto-precio">S/ @producto.Precio.ToString("0.00")</span>
                @if (!string.IsNullOrWhiteSpace(busqueda))
                {
                    <span class="producto-categoria">@producto.Categoria.Nombre · @producto.Marca</span>
                }
                @if (agotado)
                {
                    <span class="badge-agotado">Sin stock</span>
                }
            </button>
        }
    </div>

    @if (carrito.Count > 0)
    {
        <div class="carrito-barra" @onclick="() => mostrandoCarrito = true">
            <span>@carrito.Sum(l => l.Cantidad) ítem(s) · S/ @carrito.Sum(l => l.Subtotal).ToString("0.00")</span>
            <span>Ver carrito &rarr;</span>
        </div>
    }

    @if (mostrandoCarrito)
    {
        <div class="overlay" @onclick="() => mostrandoCarrito = false">
            <div class="panel-carrito" @onclick:stopPropagation="true">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="mb-0">Carrito</h5>
                    <button class="btn-close" @onclick="() => mostrandoCarrito = false"></button>
                </div>

                @if (carrito.Count == 0)
                {
                    <p class="text-muted">El carrito está vacío.</p>
                }
                else
                {
                    @foreach (var linea in carrito)
                    {
                        <div class="linea-carrito">
                            <div class="flex-grow-1">
                                <div>@linea.Producto.Nombre @(linea.ForzarVenta ? "⚠" : "")</div>
                                @if (linea.OpcionesSeleccionadas.Count > 0)
                                {
                                    <small class="text-muted">@string.Join(", ", linea.OpcionesSeleccionadas.Select(o => o.Nombre))</small>
                                }
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => CambiarCantidad(linea, -1)">-</button>
                                <span>@linea.Cantidad</span>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => CambiarCantidad(linea, 1)">+</button>
                            </div>
                            <div class="text-end" style="min-width: 70px;">S/ @linea.Subtotal.ToString("0.00")</div>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => carrito.Remove(linea)">✕</button>
                        </div>
                    }

                    <div class="d-flex justify-content-between mt-3 mb-2">
                        <strong>Total</strong>
                        <strong>S/ @carrito.Sum(l => l.Subtotal).ToString("0.00")</strong>
                    </div>

                    <button class="btn btn-primary w-100" @onclick="ConfirmarPedidoAsync" disabled="@confirmando">
                        @(confirmando ? "Confirmando..." : "Confirmar Pedido")
                    </button>
                }
            </div>
        </div>
    }

    @if (productoModal is not null)
    {
        <div class="overlay" @onclick="CerrarModal">
            <div class="panel-modal" @onclick:stopPropagation="true">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="mb-0">@productoModal.Nombre</h5>
                    <button class="btn-close" @onclick="CerrarModal"></button>
                </div>

                @if (mensajeErrorModal is not null)
                {
                    <div class="alert alert-danger py-2">@mensajeErrorModal</div>
                }

                @if (agotadoModal)
                {
                    <div class="alert alert-warning py-2">
                        Sin stock suficiente para preparar este producto.
                        <div class="form-check mt-1">
                            <input class="form-check-input" type="checkbox" id="forzarVenta" @bind="forzarVentaModal" />
                            <label class="form-check-label" for="forzarVenta">Forzar venta de todas formas</label>
                        </div>
                    </div>
                }

                @foreach (var vinculo in productoModal.GruposModificadores)
                {
                    var grupo = vinculo.GrupoModificador;
                    <div class="mb-3">
                        <div class="fw-semibold">@grupo.Nombre @(grupo.EsObligatorio ? "*" : "")</div>
                        @foreach (var opcion in grupo.Opciones.Where(o => o.Activo))
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="@(grupo.PermiteMultiple ? "checkbox" : "radio")"
                                       name="@($"grupo{grupo.Id}")"
                                       id="@($"opcion{opcion.Id}")"
                                       checked="@opcionesSeleccionadasModal.Contains(opcion.Id)"
                                       @onclick="() => ToggleOpcionModal(grupo, opcion)" />
                                <label class="form-check-label" for="@($"opcion{opcion.Id}")">
                                    @opcion.Nombre @(opcion.PrecioAdicional > 0 ? $"(+S/ {opcion.PrecioAdicional:0.00})" : "")
                                    @if (disponibilidadOpciones.TryGetValue(opcion.Id, out var dispOpcion) && !dispOpcion)
                                    {
                                        <span class="badge-agotado-opcion">Sin stock</span>
                                    }
                                </label>
                            </div>
                        }
                    </div>
                }

                <div class="d-flex align-items-center gap-2 mb-3">
                    <span>Cantidad</span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => cantidadModal = Math.Max(1, cantidadModal - 1)">-</button>
                    <span>@cantidadModal</span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => cantidadModal++">+</button>
                </div>

                <button class="btn btn-primary w-100" @onclick="ConfirmarModal">Agregar al carrito</button>
            </div>
        </div>
    }
}

<style>
