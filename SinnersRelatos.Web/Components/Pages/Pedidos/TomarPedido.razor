        font-size: 1.5rem;
        text-decoration: none;
        color: var(--brand-primary);
    }

    .mesa-titulo {
        font-weight: 700;
    }

    .mesero-nombre {
        font-size: 0.8rem;
        color: #777;
    }

    .ya-pedido {
        margin: 0.5rem 1rem;
        padding: 0.5rem 0.75rem;
        background: #f7f5f3;
        border-radius: 0.5rem;
        font-size: 0.9rem;
    }

    .item-listo {
        color: #1b5e20;
    }

    .badge-listo {
        display: inline-block;
        margin-left: 0.5rem;
        background: #e8f5e9;
        color: #1b5e20;
        border: 1px solid #2e7d32;
        border-radius: 1rem;
        padding: 0.05rem 0.6rem;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .marca-tabs {
        display: flex;
        gap: 0.5rem;
        padding: 0 1rem;
    }

