@page "/mesas"
@inherits PaginaConSesion
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SinnersRelatos.Web.Models

<PageTitle>Mesas</PageTitle>

<div class="seleccion-local">
    <h1 class="text-center mb-4">¿Qué local?</h1>

    <button class="local-card local-sinners" @onclick="() => IrAMapa(Marca.Sinners)">
        <span class="local-nombre">Sinners</span>
        <span class="local-detalle">Cafetería · 7 Mesas + Barra</span>
    </button>

    <button class="local-card local-relatos" @onclick="() => IrAMapa(Marca.Relatos)">
        <span class="local-nombre">Relatos</span>
        <span class="local-detalle">Restaurante · 7 Mesas</span>
    </button>
</div>

<style>
    .seleccion-local {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        max-width: 480px;
        margin: 0 auto;
        padding: 1rem;
    }

    .local-card {
        border: 1px solid var(--brand-primary-border);
        border-radius: var(--radio);
        padding: 2rem 1.5rem;
        color: #fff;
        background-color: var(--brand-primary);
        box-shadow: 0 10px 28px rgba(101, 6, 16, 0.4);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.35rem;
        cursor: pointer;
        transition: transform 0.1s ease, opacity 0.1s ease;
    }

    .local-card:active {
        transform: scale(0.98);
        opacity: 0.9;
    }

    .local-relatos {
        background-color: var(--surface-1);
        box-shadow: none;
    }

    .local-relatos:hover {
        background-color: var(--surface-2);
    }

    .local-nombre {
        font-size: 1.75rem;
        font-weight: 600;
    }

    .local-detalle {
        font-size: 0.95rem;
        opacity: 0.9;
    }
</style>

@code {
    private void IrAMapa(Marca marca) => Navigation.NavigateTo($"/mesas/{marca.ToString().ToLowerInvariant()}");
}
