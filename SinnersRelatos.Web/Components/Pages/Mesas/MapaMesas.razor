@page "/mesas/{MarcaTexto}"
@inherits PaginaConSesion
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SinnersRelatos.Web.Models
@using SinnersRelatos.Web.Services.Interfaces
@implements IDisposable
@inject IMesaService MesaService
@inject IPedidoService PedidoService

<PageTitle>Mesas - @NombreLocal</PageTitle>

<div class="mapa-header">
    <a href="/mesas" class="volver">&larr; Volver</a>
    <h1>@NombreLocal</h1>
    @if (!modoFusion)
    {
        <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="ActivarModoFusion">Fusionar mesas</button>
    }
    else
    {
        <div class="ms-auto d-flex gap-1">
            <button class="btn btn-sm btn-primary" disabled="@(mesasSeleccionadas.Count < 2)" @onclick="FusionarAsync">
                Fusionar (@mesasSeleccionadas.Count)
            </button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="CancelarFusion">Cancelar</button>
        </div>
    }
</div>

@if (modoFusion)
{
    <p class="px-3 mb-0 text-muted small">Toca 2 o más mesas para fusionarlas. La primera que toques será la cuenta principal.</p>
}

@if (mensajeError is not null)
{
    <div class="alert alert-danger mx-3 mt-2 py-2">
        @mensajeError
        <button type="button" class="btn-close float-end" @onclick="() => mensajeError = null"></button>
    </div>
}

<div class="leyenda">
    <span class="chip chip-libre">Libre</span>
    <span class="chip chip-ocupada">Ocupada</span>
</div>

@if (cargando)
{
    <p><em>Cargando mapa...</em></p>
}
else if (marcaInvalida)
{
    <p class="text-danger">Local no reconocido.</p>
}
else
{
    <div class="mapa-scroll">
        <svg viewBox="0 0 1000 550" class="mapa-svg @(marca == Marca.Sinners ? "mapa-svg-sinners" : "")" xmlns="http://www.w3.org/2000/svg">
            <rect x="10" y="10" width="980" height="530" fill="none" stroke="#333" stroke-width="4" />

            @foreach (var mesaEstado in mesas)
            {
                var rect = ObtenerRect(mesaEstado.Mesa);
                if (rect is null)
                {
                    continue;
                }

                var (x, y, w, h) = rect.Value;
                var etiqueta = mesaEstado.Mesa.Tipo == TipoMesa.Barra ? $"Barra {mesaEstado.Mesa.Numero}" : $"Mesa {mesaEstado.Mesa.Numero}";
                var claseEstado = mesaEstado.Ocupada ? "mesa-ocupada" : "mesa-libre";
                var ordenSeleccion = mesasSeleccionadas.IndexOf(mesaEstado.Mesa.Id);
                var seleccionada = ordenSeleccion >= 0;
                var mostrarTiempo = mesaEstado.Ocupada && mesaEstado.OcupadaDesde is not null;
                var yEtiqueta = mostrarTiempo ? y + h / 2 - 9 : y + h / 2;

                <g class="mesa-grupo @claseEstado @(seleccionada ? "mesa-seleccionada" : "") @(mesaEstado.Mesa.Tipo == TipoMesa.Barra ? "mesa-tipo-barra" : "mesa-tipo-mesa")" @onclick="() => OnMesaClick(mesaEstado)">
                    <rect x="@x" y="@y" width="@w" height="@h" rx="6" class="mesa-rect" />
                    @* El nombre y el tiempo van juntos en un solo <g> para poder girarlos como bloque
                       en celulares en vertical (ver media query más abajo): así, aunque el mapa entero
                       esté rotado 90°/270° para aprovechar el alto de la pantalla, las palabras se leen
                       normalmente sin tener que girar el teléfono. *@
                    <g class="mesa-etiqueta">
                        <text x="@(x + w / 2)" y="@yEtiqueta" class="mesa-texto" text-anchor="middle" dominant-baseline="middle">@etiqueta</text>
                        @if (mostrarTiempo)
                        {
                            <g>
                                <text x="@(x + w / 2)" y="@(y + h / 2 + 13)" class="mesa-tiempo" text-anchor="middle" dominant-baseline="middle">⏱ @FormateoTiempo.TiempoTranscurrido(mesaEstado.OcupadaDesde!.Value)</text>
                            </g>
                        }
                    </g>
                    @if (seleccionada)
                    {
                        <g class="mesa-etiqueta">
                            <circle cx="@(x + w - 10)" cy="@(y + 10)" r="12" class="mesa-badge" />
                            <text x="@(x + w - 10)" y="@(y + 10)" class="mesa-badge-texto" text-anchor="middle" dominant-baseline="middle">@(ordenSeleccion + 1)</text>
                        </g>
                    }
                </g>
            }
        </svg>
    </div>
}

<style>
    .mapa-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.75rem 1rem 0;
    }

    .mapa-header h1 {
        font-size: 1.4rem;
        margin: 0;
    }

    .volver {
        color: var(--brand-primary);
        text-decoration: none;
        font-weight: 600;
        white-space: nowrap;
    }

    .leyenda {
        display: flex;
        gap: 0.75rem;
        padding: 0.5rem 1rem;
    }

    .chip {
        border-radius: 1rem;
        padding: 0.2rem 0.75rem;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .chip-libre {
        background: #f9eef0;
        color: var(--brand-primary);
        border: 1px solid #c9a3a9;
    }

    .chip-ocupada {
        background: var(--brand-primary);
        color: #fff;
    }

    .mapa-scroll {
        overflow-x: auto;
        padding: 0.5rem;
    }

    .mapa-svg {
        min-width: 700px;
        width: 100%;
        height: auto;
        display: block;
    }

    .mesa-grupo {
        cursor: pointer;
    }

    .mesa-libre .mesa-rect {
        fill: #f9eef0;
        stroke: #c9a3a9;
        stroke-width: 3;
    }

    .mesa-libre .mesa-texto {
        fill: var(--brand-primary);
    }

    .mesa-ocupada .mesa-rect {
        fill: var(--brand-primary);
        stroke: var(--brand-primary-dark);
        stroke-width: 3;
    }

    .mesa-ocupada .mesa-texto {
        fill: #fff;
    }

    .mesa-texto {
        font-size: 26px;
        font-weight: 600;
        pointer-events: none;
    }

    .mesa-tiempo {
        font-size: 14px;
        font-weight: 600;
        pointer-events: none;
        fill: #fff;
        opacity: 0.9;
    }

    .mesa-grupo:active .mesa-rect {
        opacity: 0.8;
    }

    .mesa-seleccionada .mesa-rect {
        stroke: var(--brand-secondary);
        stroke-width: 5;
    }

    .mesa-badge {
        fill: var(--brand-secondary);
        stroke: #fff;
        stroke-width: 2;
    }

    .mesa-badge-texto {
        fill: #fff;
        font-size: 14px;
        font-weight: 700;
        pointer-events: none;
    }

    /* En teléfonos en vertical, el mapa (dibujado en horizontal) se gira 90°
       para aprovechar el alto de la pantalla y verlo completo sin hacer scroll. */
    @@media (max-width: 700px) and (orientation: portrait) {
        .mapa-scroll {
            height: calc(100vh - 180px);
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0;
        }

        .mapa-svg {
            min-width: 0;
            max-width: none;
            flex-shrink: 0;
            width: min(calc((100vw - 3rem) * 1.69), calc(100vh - 180px));
            height: auto;
            transform: rotate(90deg);
            transform-origin: center center;
        }

        /* El mapa de Sinners va girado 180° adicionales (270° en total) para que
           quede en el sentido correcto según la disposición física del local. */
        .mapa-svg-sinners {
            transform: rotate(270deg);
        }

        /* Girar el mapa entero también gira las palabras: sin esto, el nombre y el tiempo
           quedan de costado y hay que girar el teléfono para leerlos. Cada etiqueta se gira
           en sentido contrario al mapa (como bloque, con "transform-box: fill-box" para que
           el pivote sea su propio centro y no el del SVG), dejando el texto derecho de nuevo. */
        .mesa-etiqueta {
            transform-box: fill-box;
            transform-origin: center;
        }

        .mapa-svg .mesa-etiqueta {
            transform: rotate(-90deg);
        }

        .mapa-svg-sinners .mesa-etiqueta {
            transform: rotate(90deg);
        }

        /* Al girar cada etiqueta, lo que antes era su ancho (el texto horizontal) pasa a
           ocupar el alto del cuadro de la mesa. Las Barras son bajitas (alto chico), así que
           el nombre no entra al tamaño normal: se achica la letra para que quepa sin salirse. */
        .mesa-tipo-barra .mesa-texto {
            font-size: 15px;
        }

        .mesa-tipo-barra .mesa-tiempo {
            font-size: 10px;
        }

        .mesa-tipo-mesa .mesa-texto {
            font-size: 25px;
        }

        .mesa-tipo-mesa .mesa-tiempo {
            font-size: 14px;
        }
    }
</style>

@code {
    [Parameter]
    public string MarcaTexto { get; set; } = "";

    private Marca marca;
    private bool marcaInvalida;
    private bool cargando = true;
    private List<MesaEstado> mesas = [];

    private bool modoFusion;
    private List<int> mesasSeleccionadas = [];
    private string? mensajeError;

    private string NombreLocal => marcaInvalida ? "" : marca.ToString();

    // Las mesas (tipo "Mesa") crecieron otro 15% adicional (35% en total) respecto al tamaño
    // original, centradas en el mismo punto, para que se lean mejor en celular. Los asientos de
    // barra se dejaron en su tamaño original: están a solo 5px unos de otros y agrandarlos los
    // solaparía. Todo el conjunto además quedó recentrado dentro del marco (antes tenía más aire
    // arriba/izquierda que abajo/derecha, donde quedaban pegadas las Mesas 7, 4 y 2).
    private static readonly Dictionary<(TipoMesa Tipo, int Numero), (double X, double Y, double W, double H)> LayoutSinners = new()
    {
        [(TipoMesa.Mesa, 6)] = (41.45, 39.45, 124.2, 131.1),
        [(TipoMesa.Mesa, 5)] = (251.45, 39.45, 124.2, 131.1),
        [(TipoMesa.Barra, 1)] = (588.55, 57.5, 70, 55),
        [(TipoMesa.Barra, 2)] = (663.55, 57.5, 70, 55),
        [(TipoMesa.Barra, 3)] = (738.55, 57.5, 70, 55),
        [(TipoMesa.Barra, 4)] = (813.55, 57.5, 70, 55),
        [(TipoMesa.Barra, 5)] = (888.55, 112.5, 70, 60),
        [(TipoMesa.Barra, 6)] = (888.55, 177.5, 70, 60),
        [(TipoMesa.Mesa, 1)] = (532.4, 199.45, 117.3, 131.1),
        [(TipoMesa.Mesa, 3)] = (691.45, 143.3, 124.2, 248.4),
        [(TipoMesa.Mesa, 7)] = (41.45, 379.45, 124.2, 131.1),
        [(TipoMesa.Mesa, 4)] = (251.45, 379.45, 124.2, 131.1),
        [(TipoMesa.Mesa, 2)] = (471.45, 379.45, 124.2, 131.1),
    };

    // Mismo criterio que Sinners: 35% más grandes que el tamaño original y recentradas en el marco.
    private static readonly Dictionary<(TipoMesa Tipo, int Numero), (double X, double Y, double W, double H)> LayoutRelatos = new()
    {
        [(TipoMesa.Mesa, 1)] = (87.9, 79.45, 124.2, 131.1),
        [(TipoMesa.Mesa, 2)] = (567.9, 79.45, 124.2, 131.1),
        [(TipoMesa.Mesa, 3)] = (787.9, 79.45, 124.2, 131.1),
        [(TipoMesa.Mesa, 5)] = (87.9, 339.45, 124.2, 131.1),
        [(TipoMesa.Mesa, 6)] = (317.9, 339.45, 124.2, 131.1),
        [(TipoMesa.Mesa, 7)] = (567.9, 339.45, 124.2, 131.1),
        [(TipoMesa.Mesa, 4)] = (787.9, 339.45, 124.2, 131.1),
    };

    private System.Timers.Timer? temporizador;

    protected override async Task OnParametersSetAsync()
    {
        marcaInvalida = !Enum.TryParse(MarcaTexto, ignoreCase: true, out marca);
        if (marcaInvalida)
        {
            cargando = false;
            return;
        }

        cargando = true;
        mesas = await MesaService.ListarPorMarcaAsync(marca);
        cargando = false;

        // Se crea una sola vez (persiste entre cambios de marca dentro del mismo componente) y
        // refresca tanto la ocupación de las mesas como el contador de tiempo de cada una.
        if (temporizador is null)
        {
            temporizador = new System.Timers.Timer(30_000);
            temporizador.Elapsed += async (_, _) => await RefrescarAsync();
            temporizador.Start();
        }
    }

    private async Task RefrescarAsync()
    {
        if (marcaInvalida)
            return;

        mesas = await MesaService.ListarPorMarcaAsync(marca);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => temporizador?.Dispose();

    private (double X, double Y, double W, double H)? ObtenerRect(Mesa mesa)
    {
        var layout = mesa.Marca == Marca.Sinners ? LayoutSinners : LayoutRelatos;
        return layout.TryGetValue((mesa.Tipo, mesa.Numero), out var rect) ? rect : null;
    }

    private void OnMesaClick(MesaEstado mesaEstado)
    {
        if (!modoFusion)
        {
            Navigation.NavigateTo($"/pedido/mesa/{mesaEstado.Mesa.Id}");
            return;
        }

        if (!mesasSeleccionadas.Remove(mesaEstado.Mesa.Id))
            mesasSeleccionadas.Add(mesaEstado.Mesa.Id);
    }

    private void ActivarModoFusion()
    {
        modoFusion = true;
        mesasSeleccionadas = [];
        mensajeError = null;
    }

    private void CancelarFusion()
    {
        modoFusion = false;
        mesasSeleccionadas = [];
    }

    private async Task FusionarAsync()
    {
        if (usuarioActor is null)
        {
            Navigation.NavigateTo($"/login?returnUrl=/mesas/{MarcaTexto}");
            return;
        }

        try
        {
            await PedidoService.FusionarAsync(mesasSeleccionadas, usuarioActor.Id);
            Navigation.NavigateTo($"/pedido/mesa/{mesasSeleccionadas[0]}");
        }
        catch (InvalidOperationException ex)
        {
            mensajeError = ex.Message;
        }
    }
}
