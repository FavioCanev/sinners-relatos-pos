@page "/login"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.ComponentModel.DataAnnotations
@using SinnersRelatos.Web.Services.Interfaces
@inject IUsuarioService UsuarioService
@inject ISesionService SesionService
@inject NavigationManager Navigation

<PageTitle>Iniciar Sesión</PageTitle>

<div class="login-wrap">
    <img src="logo.png" alt="Sinners &amp; Relatos" class="login-logo" />
    <h1 class="text-center mb-4">Iniciar sesión</h1>

    <EditForm Model="formulario" OnValidSubmit="IngresarAsync" class="login-card">
        <DataAnnotationsValidator />

        @if (mensajeError is not null)
        {
            <div class="alert alert-danger py-2">@mensajeError</div>
        }

        <div class="mb-3">
            <label class="form-label">Usuario</label>
            <InputText class="form-control" @bind-Value="formulario.NombreUsuario" autofocus />
        </div>
        <div class="mb-3">
            <label class="form-label">Contraseña</label>
            <InputText type="password" class="form-control" @bind-Value="formulario.Password" />
        </div>

        <button type="submit" class="btn btn-primary w-100" disabled="@ingresando">
            @(ingresando ? "Ingresando..." : "Ingresar")
        </button>

        <p class="text-muted small text-center mt-2 mb-0">
            ¿Olvidaste tu contraseña? Pide a un administrador que te la restablezca desde
            "Usuarios y Empleados".
        </p>
    </EditForm>
</div>

<style>
    .login-wrap {
        max-width: 380px;
        margin: 3rem auto;
        padding: 1rem;
    }

    .login-logo {
        display: block;
        width: 220px;
        max-width: 70%;
        margin: 0 auto 1.25rem;
    }

    .login-wrap h1 {
        font-size: 1.5rem;
    }

    .login-card {
        background: var(--surface-1);
        border: 1px solid var(--line);
        border-radius: var(--radio);
        padding: 1.5rem;
    }
</style>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private readonly FormularioLogin formulario = new();

    private string? mensajeError;
    private bool ingresando;

    private async Task IngresarAsync()
    {
        ingresando = true;
        mensajeError = null;

        var usuario = await UsuarioService.ValidarCredencialesAsync(formulario.NombreUsuario, formulario.Password);
        if (usuario is null)
        {
            mensajeError = "Usuario o contraseña incorrectos.";
            ingresando = false;
            return;
        }

        await SesionService.IniciarSesionAsync(usuario);
        Navigation.NavigateTo(string.IsNullOrWhiteSpace(ReturnUrl) ? "/mesas" : ReturnUrl);
    }

    private class FormularioLogin
    {
        [Required(ErrorMessage = "Ingresa tu usuario")]
        public string NombreUsuario { get; set; } = "";

        [Required(ErrorMessage = "Ingresa tu contraseña")]
        public string Password { get; set; } = "";
    }
}
