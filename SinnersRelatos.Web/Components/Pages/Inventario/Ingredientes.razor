@page "/ingredientes"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.ComponentModel.DataAnnotations
@using SinnersRelatos.Web.Models
@using SinnersRelatos.Web.Services.Interfaces
@inject IIngredienteService IngredienteService
@inject ISesionService SesionService
@inject NavigationManager Navigation

<PageTitle>Ingredientes</PageTitle>

<h1>Ingredientes</h1>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="incluirInactivos" @bind="incluirInactivos" @bind:after="CargarAsync" />
        <label class="form-check-label" for="incluirInactivos">Mostrar inactivos</label>
    </div>
    <button class="btn btn-primary" @onclick="MostrarFormularioCreacion">+ Nuevo Ingrediente</button>
</div>

@if (mensajeError is not null)
{
    <div class="alert alert-danger alert-dismissible">
        @mensajeError
        <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
    </div>
}

@if (mostrandoFormulario)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">@(formulario.Id is null ? "Nuevo Ingrediente" : "Editar Ingrediente")</h5>
            <EditForm Model="formulario" OnValidSubmit="GuardarAsync">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />
                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label">Nombre</label>
                        <InputText class="form-control" @bind-Value="formulario.Nombre" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Unidad de medida</label>
                        <InputText class="form-control" @bind-Value="formulario.UnidadMedida" placeholder="ml, g, kg, unidad..." />
                    </div>
                    @if (formulario.Id is null)
                    {
                        <div class="col-md-2">
                            <label class="form-label">Stock inicial</label>
                            <InputNumber class="form-control" @bind-Value="formulario.StockInicial" step="0.001" />
                        </div>
                    }
                    <div class="col-md-2">
                        <label class="form-label">Alertar bajo</label>
                        <InputNumber class="form-control" @bind-Value="formulario.StockMinimo" step="0.001" />
                    </div>
                </div>
                <p class="text-muted small mt-2 mb-0">Se mostrará una alerta cuando el stock caiga a este nivel o menos. Déjalo en 0 para no alertar.</p>
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">Guardar</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => mostrandoFormulario = false">Cancelar</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (ingredienteAjustandoStock is not null)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Ajustar stock — @ingredienteAjustandoStock.Nombre</h5>
            <p class="text-muted mb-2">Stock actual: @ingredienteAjustandoStock.StockActual.ToString("0.###") @ingredienteAjustandoStock.UnidadMedida</p>
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Cantidad a sumar (usa negativo para restar)</label>
                    <input type="number" step="0.001" class="form-control" @bind="cantidadAjuste" />
                </div>
                <div class="col-md-6">
                    <button class="btn btn-primary" @onclick="AplicarAjusteAsync">Aplicar</button>
                    <button class="btn btn-outline-secondary" @onclick="() => ingredienteAjustandoStock = null">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (cargando)
{
    <p><em>Cargando...</em></p>
}
else if (ingredientes.Count == 0)
{
    <p><em>No hay ingredientes registrados.</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Unidad</th>
                    <th>Stock actual</th>
                    <th>Alertar bajo</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ingrediente in ingredientes)
                {
                    <tr>
                        <td>@ingrediente.Nombre</td>
                        <td>@ingrediente.UnidadMedida</td>
                        <td class="@(ingrediente.StockActual < 0 ? "text-danger fw-bold" : "")">
                            @ingrediente.StockActual.ToString("0.###")
                        </td>
                        <td>@(ingrediente.StockMinimo > 0 ? ingrediente.StockMinimo.ToString("0.###") : "—")</td>
                        <td>
                            @if (ingrediente.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                            @if (EsBajoStock(ingrediente))
                            {
                                <span class="badge bg-warning text-dark">⚠ Stock bajo</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => MostrarFormularioEdicion(ingrediente)">Editar</button>
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => MostrarAjusteStock(ingrediente)">Stock</button>
                            @if (ingrediente.Activo)
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => CambiarEstadoAsync(ingrediente, false)">Desactivar</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-success" @onclick="() => CambiarEstadoAsync(ingrediente, true)">Activar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Ingrediente> ingredientes = [];
    private bool cargando = true;
    private bool incluirInactivos;
    private bool mostrandoFormulario;
    private string? mensajeError;
    private FormularioIngrediente formulario = new();

    private Ingrediente? ingredienteAjustandoStock;
    private decimal cantidadAjuste;

    private UsuarioSesion? usuarioActor;

    protected override async Task OnInitializedAsync()
    {
        usuarioActor = await SesionService.ObtenerUsuarioActualAsync();
        if (usuarioActor is null)
        {
            Navigation.NavigateTo("/login?returnUrl=/ingredientes");
            return;
        }
        if (usuarioActor.Rol != RolUsuario.Administrador)
        {
            Navigation.NavigateTo("/mesas");
            return;
        }

        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;
        ingredientes = await IngredienteService.ListarAsync(incluirInactivos);
        cargando = false;
    }

    private void MostrarFormularioCreacion()
    {
        formulario = new FormularioIngrediente();
        mensajeError = null;
        mostrandoFormulario = true;
    }

    private void MostrarFormularioEdicion(Ingrediente ingrediente)
    {
        formulario = new FormularioIngrediente
        {
            Id = ingrediente.Id,
            Nombre = ingrediente.Nombre,
            UnidadMedida = ingrediente.UnidadMedida,
            StockMinimo = ingrediente.StockMinimo
        };
        mensajeError = null;
        mostrandoFormulario = true;
    }

    private bool EsBajoStock(Ingrediente ingrediente) =>
        ingrediente.StockMinimo > 0 && ingrediente.StockActual <= ingrediente.StockMinimo;

    private async Task GuardarAsync()
    {
        try
        {
            if (formulario.Id is null)
                await IngredienteService.CrearAsync(formulario.Nombre, formulario.UnidadMedida, formulario.StockInicial, formulario.StockMinimo, usuarioActor!.Id);
            else
                await IngredienteService.ActualizarAsync(formulario.Id.Value, formulario.Nombre, formulario.UnidadMedida, formulario.StockMinimo, usuarioActor!.Id);

            mostrandoFormulario = false;
            mensajeError = null;
            await CargarAsync();
        }
        catch (InvalidOperationException ex)
        {
            mensajeError = ex.Message;
        }
    }

    private void MostrarAjusteStock(Ingrediente ingrediente)
    {
        ingredienteAjustandoStock = ingrediente;
        cantidadAjuste = 0;
    }

    private async Task AplicarAjusteAsync()
    {
        if (ingredienteAjustandoStock is null || cantidadAjuste == 0)
            return;

        await IngredienteService.AjustarStockAsync(ingredienteAjustandoStock.Id, cantidadAjuste, usuarioActor!.Id);
        ingredienteAjustandoStock = null;
        await CargarAsync();
    }

    private async Task CambiarEstadoAsync(Ingrediente ingrediente, bool activo)
    {
        await IngredienteService.CambiarEstadoAsync(ingrediente.Id, activo, usuarioActor!.Id);
        await CargarAsync();
    }

    private class FormularioIngrediente
    {
        public int? Id { get; set; }

        [Required(ErrorMessage = "El nombre es obligatorio")]
        public string Nombre { get; set; } = "";

        [Required(ErrorMessage = "La unidad de medida es obligatoria")]
        public string UnidadMedida { get; set; } = "";

        public decimal StockInicial { get; set; }
        public decimal StockMinimo { get; set; }
    }
}
