@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SinnersRelatos.Web.Hubs
@using SinnersRelatos.Web.Services.Interfaces
@inject IIngredienteService IngredienteService
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (cantidad > 0)
{
    <span class="badge bg-warning text-dark ms-1">⚠ @cantidad</span>
}

@code {
    private int cantidad;
    private DotNetObjectReference<AlertaStockBajo>? referencia;
    private int? tokenSuscripcion;

    protected override async Task OnInitializedAsync() => await RecalcularAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        referencia = DotNetObjectReference.Create(this);
        tokenSuscripcion = await JS.InvokeAsync<int>("comandaHub.subscribe", ComandaEventos.AlertaStockActualizada, referencia, nameof(OnAlertaStockActualizada));
    }

    [JSInvokable]
    public async Task OnAlertaStockActualizada()
    {
        await RecalcularAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RecalcularAsync()
    {
        // IngredienteService crea su propio DbContext por llamada (ver IDbContextFactory en
        // Program.cs), así que ya no hace falta resolverlo en un scope de DI aparte para evitar
        // pisar el DbContext de la página: no comparte ninguno.
        var bajoStock = await IngredienteService.ListarBajoStockAsync();
        cantidad = bajoStock.Count;
    }

    public async ValueTask DisposeAsync()
    {
        referencia?.Dispose();

        if (tokenSuscripcion is { } token)
        {
            try
            {
                await JS.InvokeVoidAsync("comandaHub.unsubscribe", token);
            }
            catch (JSDisconnectedException)
            {
                // El circuito ya se cerró (ej. el usuario cerró la pestaña): no hay a quién
                // avisar ni falta hacerlo, la conexión de SignalR del cliente ya no existe.
            }
        }
    }
}
