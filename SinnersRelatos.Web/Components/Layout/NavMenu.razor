@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SinnersRelatos.Web.Models
@using SinnersRelatos.Web.Services.Interfaces
@inject ISesionService SesionService
@inject NavigationManager Navigation
@implements IDisposable

<div class="top-row">
    <a class="navbar-brand" href=""><img src="logo.png" alt="Sinners &amp; Relatos" class="navbar-logo" /></a>
</div>

<input type="checkbox" title="Menú" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="rail">
        @foreach (var modulo in ModulosNavegacion.Todos.Where(m => !m.SoloAdministrador || esAdministrador))
        {
            <a href="@modulo.Paginas[0].Href" class="rail-item @(modulo == moduloActual ? "active" : "")" title="@modulo.Titulo">
                <span class="rail-icono">
                    @((MarkupString)modulo.IconoSvg)
                    @if (modulo.Clave == "catalogo")
                    {
                        <AlertaStockBajo />
                    }
                </span>
                <span class="rail-texto">@modulo.Titulo</span>
            </a>
        }

        @if (sesion is not null)
        {
            <div class="rail-pie">
                <a href="mi-cuenta" class="rail-item @(EsMiCuenta ? "active" : "")" title="@sesion.NombreCompleto (@sesion.Rol)">
                    <span class="rail-icono">@((MarkupString)ModulosNavegacion.IconoCuenta)</span>
                    <span class="rail-texto">Mi cuenta</span>
                </a>
                <button type="button" class="rail-item" title="Cerrar sesión" @onclick="CerrarSesionAsync">
                    <span class="rail-icono">@((MarkupString)ModulosNavegacion.IconoSalir)</span>
                    <span class="rail-texto">Salir</span>
                </button>
            </div>
        }
    </nav>
</div>

@code {
    private UsuarioSesion? sesion;
    private bool esAdministrador;

    private string RutaActual => Navigation.ToBaseRelativePath(Navigation.Uri);
    private ModuloNavegacion? moduloActual => ModulosNavegacion.DeRuta(RutaActual);
    private bool EsMiCuenta => RutaActual.StartsWith("mi-cuenta", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await CargarSesionAsync();
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        await CargarSesionAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CargarSesionAsync()
    {
        sesion = await SesionService.ObtenerUsuarioActualAsync();
        esAdministrador = sesion?.Rol == RolUsuario.Administrador;
    }

    private async Task CerrarSesionAsync()
    {
        await SesionService.CerrarSesionAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
