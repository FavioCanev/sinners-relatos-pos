@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SinnersRelatos.Web.Models
@using SinnersRelatos.Web.Services.Interfaces
@inject ISesionService SesionService
@inject NavigationManager Navigation
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">SinnersRelatos.Web</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="mesas">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Mesas
            </NavLink>
        </div>

        @if (esAdministrador)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="usuarios">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Usuarios y Empleados
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="categorias">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Categorías
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="productos">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Productos
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="modificadores">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Modificadores
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="ingredientes">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Ingredientes
                    <AlertaStockBajo />
                </NavLink>
            </div>
        }

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="kds/barra">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> KDS Barra
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="kds/cocina">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> KDS Cocina
            </NavLink>
        </div>

        @if (esAdministrador)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="auditoria">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Auditoría
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="dashboard">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Dashboard
                </NavLink>
            </div>
        }

        @if (sesion is not null)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="mi-cuenta">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Mi Cuenta
                </NavLink>
            </div>

            <div class="nav-item px-3 mt-3 sesion-info">
                <div class="sesion-nombre">@sesion.NombreCompleto</div>
                <div class="sesion-rol">@sesion.Rol</div>
                <button class="btn btn-sm btn-outline-light mt-1" @onclick="CerrarSesionAsync">Cerrar sesión</button>
            </div>
        }
    </nav>
</div>

<style>
    .sesion-info {
        font-size: 0.85rem;
        opacity: 0.9;
    }

    .sesion-nombre {
        font-weight: 600;
    }

    .sesion-rol {
        opacity: 0.75;
    }
</style>

@code {
    private UsuarioSesion? sesion;
    private bool esAdministrador;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await CargarSesionAsync();
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        await CargarSesionAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CargarSesionAsync()
    {
        sesion = await SesionService.ObtenerUsuarioActualAsync();
        esAdministrador = sesion?.Rol == RolUsuario.Administrador;
    }

    private async Task CerrarSesionAsync()
    {
        await SesionService.CerrarSesionAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
